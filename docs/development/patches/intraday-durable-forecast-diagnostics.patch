+        try:
+            reasons = {"budget_disabled", "missing_file", "missing_key", "invalid_context",
+                "empty", "complete", "budget_exhausted", "sqlite_interrupt",
+                "sqlite_error", "os_error", "invalid_record", "identity_unavailable", "source_unpinned"}
+            names = ("requested_count", "expected_count", "validated_count", "returned_count",
