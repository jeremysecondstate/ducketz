+def test_retry_does_not_mix_explicit_native_spec_with_inherited_workflow_route(prepared, monkeypatch):
+    from ml.nightly_dispatch import RECOVERY, validate_recovery
+
+    root, spec, _ = prepared
+    _stages(monkeypatch, fail="ml.gameplan_actuals_review")
+    with pytest.raises(RuntimeError, match="exited with code 7"):
+        _prepare(prepared, start_at="gameplan_stats", stop_after="gameplan_stats")
+    failed = Path(native.overnight_status(root)["run_path"])
+    report = _report(failed)
+    # Model a valid saved workflow route; its native-shaped predecessor is not
+    # part of this attempt's route. Both specifications retain the same dates.
+    report.pop("recovery")
+    workflow = root / "saved-workflow-recovery.json"
+    workflow.write_text(json.dumps({
+        "schema_version": RECOVERY, "actor": "Scout",
+        "workflow_run_id": "synthetic-workflow",
+        "source_identity": {"commit": "a" * 40, "source_sha256": "b" * 64},
+        "datastore": str(root.resolve()), "action_date": ACTION,
+        "source_session": REVIEW, "original_deadline_at": ORIGINAL,
+        "approved_at": REQUESTED, "expires_at": report["effective_deadline_at"],
+        "authorization": "Historical synthetic fixture annotation",
+        "orders_authorized": False, "native_attempts": {},
+    }), encoding="utf-8")
+    _, workflow_evidence = validate_recovery(workflow, root=root, now=REQUESTED)
+    report["workflow_recovery"] = workflow_evidence
+    (failed / "stage-report.json").write_text(json.dumps(report), encoding="utf-8")
+    receipt = json.loads((failed / "receipt.json").read_text())
+    receipt["stage_report_checksum_sha256"] = file_checksum(failed / "stage-report.json")
+    (failed / "receipt.json").write_text(json.dumps(receipt), encoding="utf-8")
+    before = _evidence_snapshot(failed)
+    attempts = set(failed.parent.iterdir())
+    workflow_bytes, spec_bytes = workflow.read_bytes(), spec.read_bytes()
+    calls = _stages(monkeypatch)
+
+    inherited = native._resume_configuration(root, failed)
+    assert inherited["workflow_recovery"] == workflow_evidence
+    assert inherited.get("recovery") is None
+    with pytest.raises(ValueError, match="one frozen native recovery route"):
+        native._resume_configuration(root, failed, recovery_spec=spec)
+
+    assert not calls
+    assert set(failed.parent.iterdir()) == attempts
+    assert _evidence_snapshot(failed) == before
+    assert workflow.read_bytes() == workflow_bytes and spec.read_bytes() == spec_bytes
