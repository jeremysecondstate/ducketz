+# This private scope exists only for the final capacity/submission part of one
+# step, after scientific sizing. It never survives a step or enters a store
+# cache. Every reuse still needs the fresh source marker and full caller equality.
+_FORECAST_RECORD_SCOPE = ContextVar("intraday_forecast_record_scope", default=None)
+
+
+@contextmanager
+def _forecast_record_scope(owner):
+    previous = _FORECAST_RECORD_SCOPE.get()
+    if previous is not None:
+        previous[1].clear()  # Nested work cannot retain another large proof.
+    proofs, active = {}, [True]
+    token = _FORECAST_RECORD_SCOPE.set((owner, proofs, get_ident(), active))
+    try:
+        yield
+    finally:
+        active[0] = False  # Copied contexts cannot extend this call's lifetime.
+        proofs.clear()
+        _FORECAST_RECORD_SCOPE.reset(token)
+
+
+def _clear_forecast_record_scope(owner):
+    scope = _FORECAST_RECORD_SCOPE.get()
+    if scope is not None and scope[0] is owner and scope[2] == get_ident() and scope[3][0]:
+        scope[1].clear()
+
