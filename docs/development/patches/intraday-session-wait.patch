--- a/Start-15m-Data.cmd
+++ b/Start-15m-Data.cmd
@@ -1,14 +1,14 @@
 @echo off
 setlocal DisableDelayedExpansion
 echo 15-minute System 1A - data collection and preparation only.
 pushd "%~dp0"
 if errorlevel 1 exit /b 2
 if not exist ".venv\Scripts\python.exe" (
   echo Ducketz Python environment is missing.
   popd
   exit /b 2
 )
-".venv\Scripts\python.exe" -I -S -B "tools\intraday_data_host.py" --repository "%CD%" --datastore "C:\DATASTORE" %*
+".venv\Scripts\python.exe" -I -S -B "tools\intraday_session_wait.py" data %*                                       
 set "DUCKETZ_DATA_EXIT=%ERRORLEVEL%"
 popd
 exit /b %DUCKETZ_DATA_EXIT%
--- a/Start-15m-Trader.cmd
+++ b/Start-15m-Trader.cmd
@@ -1,29 +1,29 @@
 @echo off
 setlocal DisableDelayedExpansion
 echo 15-minute trader - manual start.
 echo Ctrl+C stops. If console text is selected, press Esc first.
 pushd "%~dp0"
 if errorlevel 1 (
   echo Cannot open folder.
   pause
   exit /b 2
 )
 if not exist ".venv\Scripts\python.exe" (
   echo Ducketz Python environment is missing.
   popd
   pause
   exit /b 2
 )
 (
-".venv\Scripts\python.exe" -I -S -B "tools\trader_session_host.py" --trader intraday %*
+".venv\Scripts\python.exe" -I -S -B "tools\intraday_session_wait.py" trader %*
 call set "DUCKETZ_TRADER_EXIT=%%ERRORLEVEL%%"
 setlocal EnableDelayedExpansion
 popd
 if not "!DUCKETZ_TRADER_EXIT!"=="0" (
   echo The 15-minute trader stopped with exit code !DUCKETZ_TRADER_EXIT!.
   echo Review the reason above before starting it again.
   echo A pre-existing trader may still be running. This launch never takes over or stops it.
   pause
 )
 exit /b !DUCKETZ_TRADER_EXIT!
 )
