+def _json_projection(column, fields):
+    keys = ",".join("'" + field + "'" for field in fields)
+    # json_each retains presence, unlike a multi-path json_extract array that
+    # conflates missing fields with explicitly saved JSON null. Preserve null
+    # and boolean types too, including malformed-present provenance evidence.
+    return ("(SELECT json_group_object(j.key, CASE "
+            "WHEN j.type IN ('object','array') THEN json(j.value) "
+            "WHEN j.type IN ('true','false','null') THEN json(j.type) ELSE j.value END) "
+            "FROM json_each(" + column + ") AS j WHERE j.key IN (" + keys + "))")
