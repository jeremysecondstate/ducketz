--- a/Start-Gameplan-Trader.cmd
+++ b/Start-Gameplan-Trader.cmd
@@ -1,29 +1,32 @@
 @echo off
 setlocal DisableDelayedExpansion
+echo Gameplan Trader is retired. Use the 15-Minute Trader.
+exit /b 1
+rem Historical launcher retained below; retirement exits before runtime access.
 echo Gameplan trader - manual start.
 echo Ctrl+C stops. If console text is selected, press Esc first.
 pushd "%~dp0"
 if errorlevel 1 (
   echo Cannot open folder.
   pause
   exit /b 2
 )
 if not exist ".venv\Scripts\python.exe" (
   echo Ducketz Python environment is missing.
   popd
   pause
   exit /b 2
 )
 (
 ".venv\Scripts\python.exe" -I -S -B "tools\trader_session_host.py" --trader gameplan %*
 call set "DUCKETZ_TRADER_EXIT=%%ERRORLEVEL%%"
 setlocal EnableDelayedExpansion
 popd
 if not "!DUCKETZ_TRADER_EXIT!"=="0" (
   echo The Gameplan trader stopped with exit code !DUCKETZ_TRADER_EXIT!.
   echo Review the reason above before starting it again.
   echo A pre-existing trader may still be running. This launch never takes over or stops it.
   pause
 )
 exit /b !DUCKETZ_TRADER_EXIT!
 )
--- a/tools/register_nightly_watchdog.ps1
+++ b/tools/register_nightly_watchdog.ps1
@@ -1,75 +1,79 @@
 param(
     [Parameter(Mandatory=$true)][string]$Repository,
     [Parameter(Mandatory=$true)][string]$Python,
     [Parameter(Mandatory=$true)][string]$Config,
     [Parameter(Mandatory=$true)][string]$TaskName,
     [switch]$ReadOnly
 )
 $ErrorActionPreference = 'Stop'
+# Retirement is explicit human direction; historical inspection remains available.
+if (-not $ReadOnly) {
+    throw 'Gameplan nightly dispatch is retired. Use the existing 15-minute preparation owners.'
+}
 foreach ($item in @($Repository, $Python, $Config)) {
     if (-not [IO.Path]::IsPathFullyQualified($item) -or -not (Test-Path -LiteralPath $item)) {
         throw "Expected an existing absolute local path: $item"
     }
 }
 if ((Get-TimeZone).Id -ne 'Pacific Standard Time') {
     throw 'This installation expects the Windows Pacific timezone; do not silently use another timezone.'
 }
 if (-not $ReadOnly) {
     $existing = Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue
     if ($existing -and -not ($existing.Description -like 'Ducketz deterministic responsibility dispatch.*')) {
         throw 'The requested task name belongs to another task; preserve it and choose the owned watchdog name.'
     }
     $arguments = '-B -m tools.nightly_watchdog --config "' + $Config + '"'
     $stats = New-ScheduledTaskTrigger -Daily -At '17:30'
     # America/Los_Angeles: Windows' Pacific Standard Time applies PDT/PST.
     # Floating wall time is intentional; an offset would pin the UTC hour.
     $stats.StartBoundary = (Get-Date).ToString('yyyy-MM-dd') + 'T17:30:00'
     $description = 'Ducketz deterministic responsibility dispatch. Gameplan Stats only at 17:30 America/Los_Angeles; evening kickoff remains 21:05. One dated workflow; no trader control.'
     if ($existing) {
         if (@($existing.Actions).Count -ne 1 -or
             $existing.Actions[0].Execute -ne $Python -or
             $existing.Actions[0].Arguments -ne $arguments -or
             $existing.Actions[0].WorkingDirectory -ne $Repository) {
             throw 'Existing dispatch action differs from the reviewed binding; preserve it for explicit review.'
         }
         # Extend only the existing trigger collection. Do not re-create the
         # principal, settings, enabled state, original timer or logon binding.
         $hasStats = @($existing.Triggers | Where-Object {
             $_.CimClass.CimClassName -eq 'MSFT_TaskDailyTrigger' -and
             $_.StartBoundary -match 'T17:30:00$' -and $_.DaysInterval -eq 1
         })
         if ($hasStats.Count -gt 1) { throw 'Duplicate Stats wakes require explicit review.' }
         if ($hasStats.Count -eq 0) {
             $existing.Triggers = @(@($existing.Triggers) + $stats)
         } else {
             if (-not $hasStats[0].Enabled) { throw 'Existing Stats trigger is disabled; preserve its explicit state.' }
         }
         $existing.Description = $description
         Set-ScheduledTask -InputObject $existing | Out-Null
     } else {
         $action = New-ScheduledTaskAction -Execute $Python -Argument $arguments -WorkingDirectory $Repository
         $kickoff = New-ScheduledTaskTrigger -Daily -At '21:05'
         # A floating boundary follows the Windows Pacific timezone through DST.
         $kickoff.StartBoundary = (Get-Date).ToString('yyyy-MM-dd') + 'T21:05:00'
         # The timer is cheap and date-aware. AtLogOn resumes missed work after a reboot.
         $timer = New-ScheduledTaskTrigger -Once -At ((Get-Date).AddMinutes(5)) -RepetitionInterval (New-TimeSpan -Minutes 5)
         $logon = New-ScheduledTaskTrigger -AtLogOn -User ([Security.Principal.WindowsIdentity]::GetCurrent().Name)
         $principal = New-ScheduledTaskPrincipal -UserId ([Security.Principal.WindowsIdentity]::GetCurrent().Name) -LogonType Interactive -RunLevel Limited
         $settings = New-ScheduledTaskSettingsSet -StartWhenAvailable -MultipleInstances IgnoreNew -ExecutionTimeLimit (New-TimeSpan -Minutes 3) -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -WakeToRun
         Register-ScheduledTask -TaskName $TaskName -Action $action -Trigger @($stats, $kickoff, $timer, $logon) -Principal $principal -Settings $settings -Description $description -Force | Out-Null
     }
 }
 $task = Get-ScheduledTask -TaskName $TaskName
 $info = Get-ScheduledTaskInfo -TaskName $TaskName
 [pscustomobject]@{
     TaskName=$task.TaskName; State=[string]$task.State; Timezone=(Get-TimeZone).Id
     NextRunTime=$info.NextRunTime.ToString('o'); LastRunTime=$info.LastRunTime.ToString('o')
     LastTaskResult=$info.LastTaskResult; Actions=@($task.Actions | Select-Object Execute,Arguments,WorkingDirectory)
     Triggers=@($task.Triggers | ForEach-Object {
         [pscustomobject]@{Kind=$_.CimClass.CimClassName; StartBoundary=$_.StartBoundary;
             Enabled=$_.Enabled; DaysInterval=$_.DaysInterval; Interval=$_.Repetition.Interval;
             Duration=$_.Repetition.Duration; UserId=$_.UserId}
     })
     StartWhenAvailable=$task.Settings.StartWhenAvailable; MultipleInstances=[string]$task.Settings.MultipleInstances
     LogonType=[string]$task.Principal.LogonType
 } | ConvertTo-Json -Depth 8
