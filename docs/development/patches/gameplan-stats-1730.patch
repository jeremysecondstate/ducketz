+def session_phase(source_session, now=None):
+    """Release one source session's phases, independently of the current hour.
+
+    These wall-clock boundaries are localized separately so weekends, midnight
+    and DST cannot turn an already released prior night back into waiting work.
+    The 21:00 data minimum deliberately differs from the retained 21:05 wake.
+    """
+    observed = utc_timestamp(now)
