+"""Source-session phase execution checks; every worker/provider effect is mocked."""
+import json
+from pathlib import Path
+
+from filelock import FileLock, Timeout
+import pandas as pd
+import pytest
+
+from ml import nightly_workflow as workflow
+from ml import nightly_dispatch as dispatch
+from ml.artifacts import utc_timestamp
+from test_nightly_dispatch import config, identity
+from test_nightly_workflow import _write_native
+
+
+def execute(config, now, calls, **kwargs):
+    config["continue_until_complete"] = True
+    return workflow.run_workflow(config, now=now, identity=identity, supervise=False,
+        execute_step=lambda config, state, step, save: calls.append(step) or {"files": {}}, **kwargs)
+
+
+@pytest.mark.parametrize("mode", [{}, {"catch_up": True}, {"stats_only": True},
+                                  {"responsibility": "stats"}])
+def test_172959_cannot_start_new_stats(config, mode):
+    calls = []
+    result = execute(config, "2026-10-27T00:29:59Z", calls, **mode)
+    # A missed older night may continue, but never the new October 26 snapshot.
+    assert not calls or result["source_session"] < "2026-10-26"
+    assert not (Path(config["state_root"]) / "runs/2026-10-27/state.json").exists()
+
+
+@pytest.mark.parametrize("stamp", ["2026-10-27T00:30:00Z", "2026-10-27T03:59:59Z"])
+def test_early_run_executes_exactly_stats_and_yields_ownership(config, stamp):
+    calls = []
+    result = execute(config, stamp, calls, stats_only=True)
