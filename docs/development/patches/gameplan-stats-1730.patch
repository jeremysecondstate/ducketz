+            files = tuple(dict.fromkeys(path for _, paths, _ in pieces for path in paths))
+            inventory = {"source_contract": source_contract, "dataset": stock_price_dataset(source_contract),
+                         "by_symbol": {symbol: item[2] for symbol, item in zip(symbols, pieces)},
