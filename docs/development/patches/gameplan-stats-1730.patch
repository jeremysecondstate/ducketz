+        raise ValueError("Nightly source session must be an unambiguous calendar date")
+    local = day.tz_localize("America/Los_Angeles")
+    stats = local.replace(hour=17, minute=30).tz_convert("UTC")
+    evening = local.replace(hour=21).tz_convert("UTC")
+    kickoff = local.replace(hour=21, minute=5).tz_convert("UTC")
+    return {"stats_eligible_at": stats.isoformat(), "evening_eligible_at": evening.isoformat(),
+            "kickoff_at": kickoff.isoformat(), "stats_eligible": observed >= stats,
+            "evening_eligible": observed >= evening, "kickoff_eligible": observed >= kickoff}
+
