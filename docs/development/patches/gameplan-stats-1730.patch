+def _source_session_for_deadline(deadline: object) -> str:
+    """Recover legacy runs' reviewed session from their original action date."""
+    action = utc_timestamp(deadline).tz_convert(SCHEDULE_TIMEZONE)
+    label = pd.Timestamp(action.date())
+    calendar = xcals.get_calendar("XNYS", start=label - pd.Timedelta(days=31),
+                                 end=label + pd.Timedelta(days=14))
+    session = calendar.date_to_session(label, direction="next")
+    return pd.Timestamp(calendar.previous_session(session)).date().isoformat()
+
