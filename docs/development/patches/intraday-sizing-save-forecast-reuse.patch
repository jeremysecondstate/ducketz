+
+# Capture the original descriptors once; comparing with mutable class attributes
+# would mistake a later callback replacement for native validation.
+from .store import ShadowStore as _SizingSaveShadowStore
+
+_SIZING_SAVE_INTENTION_CLASS = IntentionStore
+_SIZING_SAVE_INTENTION_METHODS = {name: IntentionStore.__dict__[name] for name in (
+    "get", "_value", "record", "_forecast", "_ordinary_forecast_marker",
+    "_ordinary_forecast_preflight", "_ordinary_forecast_recheck", "save_sizing",
+    "_revision_sizing", "_recovery_sizing_reader", "_revision_sizing_row")}
+_SIZING_SAVE_STORE_METHODS = {name: _SizingSaveShadowStore.__dict__[name] for name in (
+    "connect", "_forecast_value", "_execution_forecast_generation", "_execution_forecast_schema")}
+
+
+def _sizing_save_forecast_reuse(owner):
+    """Custom validation and connection callbacks keep their original reads."""
+    if type(owner) is not _SIZING_SAVE_INTENTION_CLASS or type(owner.store) is not _SizingSaveShadowStore:
+        return False
+    for instance, expected in ((owner, _SIZING_SAVE_INTENTION_METHODS),
+                               (owner.store, _SIZING_SAVE_STORE_METHODS)):
+        if any(name in instance.__dict__ or type(instance).__dict__.get(name) is not native
+               for name, native in expected.items()):
+            return False
+    return True
