+    def cache_read(self, report):
+        """Bounded aggregate only; no source identities or exception text."""
+        try:
+            reasons = {"budget_disabled", "missing_file", "missing_key", "invalid_context",
+                "empty", "complete", "budget_exhausted", "sqlite_interrupt",
+                "sqlite_error", "os_error", "invalid_record", "identity_unavailable", "source_unpinned"}
+            names = ("requested_count", "expected_count", "validated_count", "returned_count",
+                     "discarded_count", "rejected_count")
+            if (type(report) is not dict or set(report) != set(names) | {
+                    "schema_version", "reason", "sqlite_errorcode"}
+                    or report["schema_version"] != "sizing-cache-load-outcome-v1"
+                    or report["reason"] not in reasons
+                    or any(type(report[name]) is not int or not 0 <= report[name] <= 2147483647
+                           for name in names)):
+                self.read_unavailable = True
+                return
+            code = report["sqlite_errorcode"]
+            if code is not None and (type(code) is not int or not 0 <= code <= 2147483647):
+                self.read_unavailable = True
+                return
+            stats = self.sizing_cache
+            stats["attempts"] = min(2147483647, stats["attempts"] + 1)
+            outcomes = stats["outcomes"]
+            outcomes[report["reason"]] = min(2147483647, outcomes.get(report["reason"], 0) + 1)
+            for name in names:
+                stats[name] = min(2147483647, stats[name] + report[name])
+            if code is not None:
+                bucket = {sqlite3.SQLITE_INTERRUPT: "sqlite_interrupt_count",
+                          sqlite3.SQLITE_BUSY: "sqlite_busy_count",
+                          sqlite3.SQLITE_LOCKED: "sqlite_locked_count"}.get(code & 255,
+                              "sqlite_other_count")
+                stats[bucket] = min(2147483647, stats[bucket] + 1)
+        except Exception:
+            self.read_unavailable = True
