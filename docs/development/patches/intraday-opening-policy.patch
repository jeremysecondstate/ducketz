                              "distance_vwap": cs[-1] / vwap - 1,
                              "distance_sma20": cs[-1] / (sum(cs[-20:]) / 20) - 1,
                              "atr_relative_price": sum(tr) / 14 / cs[-1],
                              "relative_volume": vs[-1] / baseline})
