 def initialize_renewal_session(*, repository, datastore, profile, watchlist, config, clock=utcnow):
     """Freeze one manually admitted session, without opening any provider.
 
     The controller owns the existing manual-session lock for this entire
     lifetime. A successor receives this envelope; it never calls this function
     again or changes the scientific configuration of an unfinished cycle.
     """
     from dataclasses import asdict
     from .local_execution import load_local_binding
 
     root = Path(datastore)
     effective = with_local_data_policy(config, root).validate()
     pc, symbols = local_symbols(profile, watchlist, root)
     binding = load_local_binding(root)
     if binding.actor != pc or set(binding.symbols) != set(symbols):
         raise ContractError("Independent local execution binding does not match profile")
     if effective.source_dataset != "EQUS.MINI":
         raise ContractError("Existing single-source live provider binding required")
     started = instant(clock())
     session = dict(session_id="manual-" + pc.lower() + "-15m:" + uuid.uuid4().hex,
                 started_at=started.isoformat(), close_at=market_close_at(started).isoformat(),
                 actor=pc, symbols=list(symbols), config=asdict(effective),
                 binding_fingerprint=binding.fingerprint)
     if pc == "Atlas":
         from .split_model import ARCHITECTURE
         session["architecture"] = ARCHITECTURE
     return session
 
 
 def _renewal_histories(root, store, session, config):
     """Load retained observations only when an admitted pass needs a symbol.
 
     Idle fresh interpreters must not repeatedly read every original history.
     Within a generation the existing acquisition code can augment the mapping;
     the original session cutoff and each cycle's frozen inputs stay unchanged.
     """
     from .data import AcquisitionPending, load_local_history
     from .coverage import RECOVERY_POPULATION_CONTRACT
 
     class Histories(dict):
         def __init__(self):
             super().__init__()
             self.missing = set()
             self.loading = threading.RLock()
 
         def _load(self, symbol):
             with self.loading:
                 if super().__contains__(symbol) or symbol in self.missing or symbol not in session["symbols"]:
                     return
                 try:
                     self[symbol] = load_local_history(root, symbol, source_dataset=config.source_dataset,
                         **({"population_contract": config.population_contract} if config.population_contract else {}),
                         **({"recovery_cutoff": instant(session["started_at"])}
                            if config.population_contract == RECOVERY_POPULATION_CONTRACT else {}))
                 except Exception as exc:
                     code = getattr(exc, "sqlite_errorcode", None)
                     if (isinstance(exc, sqlite3.OperationalError) and type(code) is int
                             and code & 255 in (sqlite3.SQLITE_BUSY, sqlite3.SQLITE_LOCKED)):
                         # A busy local catalog has not established missing data.
                         # Preserve the exact cycle and retry through acquisition.
                         raise AcquisitionPending("local_history_storage_contention", retry_after_seconds=1) from exc
                     self.missing.add(symbol)
                     store.event(session["session_id"], "history_unavailable",
                                 {"error_type": type(exc).__name__, "message": str(exc)}, symbol=symbol)
 
         def __getitem__(self, symbol):
             self._load(symbol)
             return super().__getitem__(symbol)
 
         def __contains__(self, symbol):
             self._load(symbol)
             return super().__contains__(symbol)
 
         def get(self, symbol, default=None):
             self._load(symbol)
             return super().get(symbol, default)
 
         def values(self):
             # Legacy LiveHistories can infer its population contract from the
             # retained manifests, but only after a real cycle was admitted.
             for symbol in session["symbols"]:
                 self._load(symbol)
             return super().values()
 
         def __iter__(self):
             for symbol in session["symbols"]:
                 self._load(symbol)
             return super().__iter__()
 
     return Histories()
 
 
 def _renewal_execution_pass(*, store, queue, executor, renewal, clock):
     """One complete multi-symbol execution sweep and due own-order recovery.
 
     Each step has already committed its intentions, reservations, receipts and
     fills and released its execution lease before this function checkpoints.
     Resting or UNKNOWN orders do not delay renewal or get resubmitted by it.
     """
     from .account_execution import execution_failure_evidence
     from .cancellation import retry_delay
     from .split_queue import broker_due_for_pass, due_for_pass
 
     session = renewal.session
     close_at = instant(session["close_at"])
     next_recovery = instant(renewal.state.get("next_recovery", session["started_at"]))
     if renewal.stopped():
         return {"status": "STOPPED", "role": "execution"}
     if instant(clock()) >= close_at:
         return {"status": "COMPLETED", "role": "execution"}
     queue_storage_retries = []
     due = due_for_pass(queue, clock(),
         stopped=lambda: renewal.stopped() or instant(clock()) >= close_at, retries=queue_storage_retries)
     for forecast in due:
         if (renewal.stopped() or instant(clock()) >= close_at
                 or not broker_due_for_pass(queue, clock(), retries=queue_storage_retries)):
             break
         try:
             step_started_at, step_started_perf = instant(clock()), time.perf_counter()
             result = executor.step(forecast)
             if session.get("architecture") == "independent-1a1b-v1":
                 try:
                     completed_at = instant(clock())
                     submitted = result.get("disposition") == "submitted"
                     store.event(session["session_id"], "system_1b_execution_measured", {
                         "forecast_id": forecast["forecast_id"],
                         "forecast_to_step_seconds": max(0., (step_started_at - instant(forecast["issued_at"])).total_seconds()),
                         "execution_step_seconds": time.perf_counter() - step_started_perf,
                         "forecast_to_order_result_seconds": (max(0., (completed_at - instant(forecast["issued_at"])).total_seconds())
                                                              if submitted else None),
                         "order_result": "submitted" if submitted else "unknown_or_recovery_required"
                             if result.get("disposition") == "submission_recovery_required" else "no_confirmed_new_submission",
                         "target_deadline_missed": completed_at >= instant(forecast["target_close"]),
                     }, symbol=forecast["symbol"])
                 except Exception:
                     pass  # Timing evidence cannot alter manual controls or order state.
             store.event(session["session_id"], "execution_step", result, symbol=forecast["symbol"])
             print(json.dumps({"event": "execution_disposition", "symbol": forecast["symbol"],
                 **{key: result.get(key) for key in ("side", "desired_quantity", "adjusted_quantity",
                     "disposition", "submission_status", "submitted_quantity", "filled_quantity")}}), flush=True)
             disposition = result["disposition"]
             if disposition == "previous_intention_reconciliation" or result["evidence"].get("proven_unsent_retry_eligible"):
                 unknown_without_broker_wait = (
                     disposition == "previous_intention_reconciliation"
                     and result["evidence"].get("reason_code") == "EXACT_BROKER_ORDER_ID_UNAVAILABLE"
                     and result["evidence"].get("retry_after_seconds") is None
                     and not result["evidence"].get("proven_unsent_retry_eligible"))
                 queue.defer(forecast["forecast_id"], now=clock(),
                     seconds=result["evidence"].get("retry_after_seconds") or 3,
                     broker_wait=not unknown_without_broker_wait)
             elif disposition == "submission_recovery_required":
                 queue.broker_wait(now=clock(), seconds=result["evidence"].get("retry_after_seconds") or 3)
                 queue.complete(forecast["forecast_id"], disposition)
             elif result["kind"] == "sizing_unavailable":
                 if disposition == "quote_stale_or_future" and instant(clock()) < instant(forecast["target_close"]):
                     queue.defer(forecast["forecast_id"], now=clock(), seconds=3, broker_wait=False)
                 else:
                     queue.complete(forecast["forecast_id"], "sizing_unavailable")
             else:
                 queue.complete(forecast["forecast_id"], disposition)
         except Exception as exc:
             delay = retry_delay(exc, clock())
             queue.defer(forecast["forecast_id"], now=clock(), seconds=delay, broker_wait=True)
             store.event(session["session_id"], "execution_retry", {
                 "forecast_id": forecast["forecast_id"], "error_type": type(exc).__name__,
                 "message": str(exc), "retry_after_seconds": delay,
                 "diagnostics": execution_failure_evidence(exc)}, symbol=forecast["symbol"])
             break
     if (not renewal.stopped() and instant(clock()) < close_at
             and instant(clock()) >= next_recovery
             and broker_due_for_pass(queue, clock(), retries=queue_storage_retries)):
         try:
             executor.recover()
             delay = 3
         except Exception as exc:
             delay = retry_delay(exc, clock())
             queue.broker_wait(now=clock(), seconds=delay)
             store.event(session["session_id"], "order_recovery_retry", {
                 "error_type": type(exc).__name__, "message": str(exc), "retry_after_seconds": delay,
                 "diagnostics": execution_failure_evidence(exc)})
         next_recovery = instant(clock()) + timedelta(seconds=delay)
     if renewal.stopped():
         return {"status": "STOPPED", "role": "execution"}
     if instant(clock()) >= close_at:
         return {"status": "COMPLETED", "role": "execution"}
     continuation = {"next_recovery": next_recovery.isoformat()}
     if queue_storage_retries:
         continuation["queue_storage_retries"] = queue_storage_retries
     renewal.checkpoint(continuation,
                        (instant(clock()) + timedelta(seconds=3 if queue_storage_retries else 1)).isoformat())
     raise RuntimeError("Renewal checkpoint must end the worker")
 
 
 def run_renewal_lane(role, *, repository, datastore, profile, watchlist, renewal,
                      clock=utcnow, sleep=time.sleep):
     """Run one independently renewable lane in an already manual session.
 
     Only the execution lane constructs a broker or has execution authority.
     Research, scoring and collection can finish their full passes concurrently
     without blocking execution or restarting between individual symbols.
     """
     from .local_execution import load_local_binding
     from dotenv import load_dotenv
 
     if role not in {"execution", "forecast", "scoring", "candles", "market_inputs"} and not re.fullmatch(r"forecast-[0-9]+", role):
         raise ContractError("Unknown manual-session renewal lane")
     root, repository = Path(datastore), Path(repository)
     session = renewal.session
     pc, symbols = local_symbols(profile, watchlist, root)
     binding = load_local_binding(root)
     if (pc != session["actor"] or list(symbols) != session["symbols"]
             or binding.actor != pc or set(binding.symbols) != set(symbols)
             or binding.fingerprint != session["binding_fingerprint"]):
         raise ContractError("Manual session local membership changed")
     if renewal.stopped():
         return {"status": "STOPPED", "role": role}
     config_fields = dict(session["config"])
     config_fields["models"] = tuple(config_fields["models"])
     config = ResearchConfig(**config_fields).validate()
     close_at = instant(session["close_at"])
     split_scoring = pc == "Atlas" and session.get("architecture") == "independent-1a1b-v1" and role == "scoring"
     if role != "candles" and not split_scoring and instant(clock()) >= close_at:
         return {"status": "COMPLETED", "role": role}
     load_dotenv(repository / ".env")
 
     def pause(seconds):
         end = time.monotonic() + max(0, float(seconds))
         while time.monotonic() < end:
             if renewal.stopped():
                 raise InterruptedError("Manual session stopped; durable work retained")
             sleep(min(1, max(0, end - time.monotonic())))
 
     def setup():
         store = ShadowStore(root / "intraday/shadow.sqlite3")
         return store, ExecutionQueue(store, session["session_id"], actor=pc)
 
     try:
         store, queue = retry_renewal_storage_setup(setup, role=role, stopped=renewal.stopped,
             permitted=lambda: role == "candles" or split_scoring or instant(clock()) < close_at, pause=pause)
     except InterruptedError:
         if not renewal.stopped() and (role == "candles" or split_scoring or instant(clock()) < close_at):
             raise
         return {"status": "STOPPED" if renewal.stopped() else "COMPLETED", "role": role}
 
     if role == "execution":
         from .account_execution import IntradayAccountExecutor
         from app.services.schwab import SchwabSession
         executor = IntradayAccountExecutor(datastore=root, store=store, broker=SchwabSession(),
             local_symbols=symbols, session_started_at=instant(session["started_at"]), clock=clock,
             manual_authority=lambda: not renewal.stopped() and instant(clock()) < close_at,
             actor=pc, stopped=renewal.stopped, diagnostic_session_id=session["session_id"])
         renewal.wait_due(clock=clock, sleep=sleep)
         return _renewal_execution_pass(store=store, queue=queue, executor=executor, renewal=renewal, clock=clock)
 
     # New Atlas sessions consume the independent data service's immutable
     # handoff. Branch before constructing any provider or retained history.
     # Existing sessions retain their original lifecycle until the normal next
     # manually authorized launch selects the installed architecture.
     from .split_model import ARCHITECTURE
     if pc == "Atlas" and session.get("architecture") == ARCHITECTURE:
         if role in {"candles", "market_inputs"}:
             return {"status": "COMPLETED", "role": role, "owner": "independent_system_1a"}
         if role == "scoring":
             from .split_scoring import renewal_scoring_pass
             renewal.wait_due(clock=clock, sleep=sleep)
             return renewal_scoring_pass(root=root, store=store, renewal=renewal, config=config, clock=clock)
         if role == "forecast" or role.startswith("forecast-"):
             from .split_model import renewal_model_pass
             index = int(role.split("-", 1)[1]) if role.startswith("forecast-") else 0
             count = min(config.symbol_workers, len(symbols))
             if not 0 <= index < count:
                 raise ContractError("Model lane differs from this session's frozen concurrency")
             renewal.wait_due(clock=clock, sleep=sleep)
             return renewal_model_pass(root=root, store=store, queue=queue, renewal=renewal,
                                       config=config, clock=clock, lane_index=index, lane_count=count)
     elif role.startswith("forecast-"):
         raise ContractError("Partitioned model lanes require an independently split Atlas session")
 
     if role == "market_inputs":
         if not config.market_inputs_enabled:
             return {"status": "COMPLETED", "role": role}
         from .market_input_runtime import renewal_market_input_pass
         try:
             return renewal_market_input_pass(root=root, symbols=symbols, store=store,
                 renewal=renewal, clock=clock, config=config, sleep=sleep)
         except Exception as exc:
             if renewal.stopped():
                 return {"status": "STOPPED", "role": role}
             # This lane was optional in the original threaded session: source
             # failures never revoke core forecast/order authority. Record the
             # failure and end this lane; do not manufacture a blind retry loop.
             evidence = {"error_type": type(exc).__name__, "core_forecasts_continue": True,
                         "automatic_lane_restart": False}
             try:
                 store.event(session["session_id"], "market_input_worker_failed", evidence)
             except Exception:
                 print(encoded({"event": "market_input_worker_failed", **evidence}), flush=True)
             return {"status": "COMPLETED", "role": role, "optional_input_status": "FAILED", **evidence}
 
     from .data import AcquisitionJournal
     from app.services.databento_market_data import DatabentoMarketDataProvider
     histories = _renewal_histories(root, store, session, config)
     provider = DatabentoMarketDataProvider()
     if provider.dataset != config.source_dataset:
         raise ContractError("Provider binding differs from selected single source")
     journal = AcquisitionJournal(root / "intraday/acquisition.sqlite3")
     renewal.wait_due(clock=clock, sleep=sleep)
     try:
         if role == "forecast":
             runner = ShadowRunner(store=store, pc=pc, symbols=symbols, config=config, clock=clock,
                 stopped=lambda: renewal.stopped() or instant(clock()) >= close_at)
             forecasting_loop(runner, histories=histories, provider=provider, journal=journal, queue=queue,
                 stopped=renewal.stopped, clock=clock, pause=pause, close_at=close_at, renewal=renewal)
         elif role == "scoring":
             scoring_loop(store, histories=histories, provider=provider, journal=journal,
                 session_id=session["session_id"], stopped=renewal.stopped, clock=clock, pause=pause,
                 close_at=close_at, actor=pc, renewal=renewal)
         else:
             from .candle_runtime import renewal_candle_pass
             return renewal_candle_pass(store=store, histories=histories, provider=provider, journal=journal,
                 renewal=renewal, config=config, clock=clock, pause=pause)
     except InterruptedError:
         if not renewal.stopped() and (role == "candles" or instant(clock()) < close_at):
             raise
     return {"status": "STOPPED" if renewal.stopped() else "COMPLETED", "role": role}
 
 
 _STARTUP_STAGES = frozenset({
     "environment", "history_load", "provider_setup", "acquisition_journal",
     "runner_setup", "market_inputs_start", "broker_session", "executor_setup",
     "market_inputs_close",
 })
 
 
 def _startup_failure_evidence(exc, *, stage):
     """Save bounded code metadata and OS codes, never messages, paths or locals."""
     from collections import deque
 
     chain, seen = [], set()
     current = exc
     while current is not None and id(current) not in seen and len(chain) < 8:
         seen.add(id(current))
         frames = deque(maxlen=8)
         trace = current.__traceback__
         while trace is not None:
             code = trace.tb_frame.f_code
             frames.append({"file": code.co_filename.replace("\\", "/").rsplit("/", 1)[-1][:120],
                            "function": code.co_name[:120], "line": trace.tb_lineno})
             trace = trace.tb_next
         item = {"error_type": type(current).__name__[:80], "frames": list(frames)}
         if isinstance(current, OSError):
             for name in ("errno", "winerror"):
                 value = getattr(current, name, None)
                 if type(value) is int:
                     item[name] = value
         chain.append(item)
         current = (current.__cause__ if current.__cause__ is not None else
                    None if current.__suppress_context__ else current.__context__)
     return {"startup_stage": stage if stage in _STARTUP_STAGES else "unknown",
             "exception_chain": chain, "root_cause": chain[-1],
             "exception_chain_truncated": current is not None}
 
 
 def _replace_session_status(temporary, status_path):
     """Allow a brief Windows reader to release the same serialized status file."""
     for attempt in range(4):
         try:
             os.replace(temporary, status_path)
             return
         except PermissionError as exc:
             if (os.name != "nt" or getattr(exc, "winerror", None) not in (5, 32)
                     or attempt == 3):
                 raise
             time.sleep(0.02 * (attempt + 1))
 
 
 def run_manual(*, repository, datastore, profile, watchlist, config, clock=utcnow, sleep=time.sleep):
     from .account_execution import IntradayAccountExecutor, execution_failure_evidence
     from .local_execution import load_local_binding
     from .data import AcquisitionJournal, load_local_history
     from .coverage import RECOVERY_POPULATION_CONTRACT
     from .cancellation import retry_delay
     from app.services.schwab import SchwabSession
     from app.services.databento_market_data import DatabentoMarketDataProvider
     from dotenv import load_dotenv
     root, repository = Path(datastore),Path(repository)
     config = with_local_data_policy(config, root)
     pc,symbols = local_symbols(profile,watchlist,root)
     binding = load_local_binding(root)
     if binding.actor != pc or set(binding.symbols) != set(symbols):
         raise ContractError("Independent local execution binding does not match profile")
     config.validate()
     if config.source_dataset != "EQUS.MINI":
         raise ContractError("Existing single-source live provider binding required")
     started = instant(clock())
     close_at = market_close_at(started)
     session_id = "manual-" + pc.lower() + "-15m:" + uuid.uuid4().hex
     stopped = threading.Event()
     final_collection_complete = threading.Event()
     worker_errors = []
     market_collector = None
     store = ShadowStore(root / "intraday/shadow.sqlite3")
     queue = ExecutionQueue(store,session_id,actor=pc)
     status_path = root / "intraday/manual-session.json"
     def status(state, **extra):
         value = dict(schema_version=VERSION,session_id=session_id,pid=os.getpid(),started_at=started.isoformat(),
                      heartbeat_at=instant(clock()).isoformat(),status=state,manual_start=True,
                      market_close_at=close_at.isoformat(),final_collection_complete=final_collection_complete.is_set(),**extra)
         temporary = status_path.with_name(status_path.name + "." + uuid.uuid4().hex + ".tmp")
         temporary.write_text(encoded(value),encoding="utf-8")
         _replace_session_status(temporary, status_path)
     def manual_authority():
         try:
             value = json.loads(status_path.read_text(encoding="utf-8"))
             return (value["session_id"] == session_id and value["pid"] == os.getpid()
                     and value["status"] == "RUNNING" and not stopped.is_set() and instant(clock()) < close_at)
         except (OSError,ValueError,KeyError):
             return False
     def pause(seconds):
         end = time.monotonic() + max(0,float(seconds))
         while time.monotonic() < end:
             if stopped.is_set():
                 raise InterruptedError("Manual session stopped; acquisition recovery retained")
             sleep(min(1,max(0,end-time.monotonic())))
     with exclusive_runtime_lock(root / "locks/intraday-manual-session.lock",process_name="intraday-manual-session"):
         status("STARTING")
         startup_stage = "environment"
         try:
             load_dotenv(repository / ".env")
             startup_stage = "history_load"
             histories = {}
             history_load_cutoff = instant(clock())
             for symbol in symbols:
                 try:
                     histories[symbol] = load_local_history(root,symbol,source_dataset=config.source_dataset,
                         **({"population_contract":config.population_contract} if config.population_contract else {}),
                         **({"recovery_cutoff":history_load_cutoff} if config.population_contract == RECOVERY_POPULATION_CONTRACT else {}))
                 except Exception as exc:
                     store.event(session_id,"history_unavailable",{"error_type":type(exc).__name__,"message":str(exc)},symbol=symbol)
             startup_stage = "provider_setup"
             provider = DatabentoMarketDataProvider()
             if provider.dataset != config.source_dataset:
                 raise ContractError("Provider binding differs from selected single source")
             startup_stage = "acquisition_journal"
             journal = AcquisitionJournal(root / "intraday/acquisition.sqlite3")
             startup_stage = "runner_setup"
             runner = ShadowRunner(store=store,pc=pc,symbols=symbols,config=config,clock=clock,
                 stopped=lambda: stopped.is_set() or instant(clock()) >= close_at)
             if config.market_inputs_enabled:
                 startup_stage = "market_inputs_start"
                 try:
                     from .market_inputs import MarketInputCollector
                     market_collector = MarketInputCollector(root, symbols)
                     startup = market_collector.start()
                     store.event(session_id,"market_input_streams_started",{"status_by_dataset":startup})
                 except Exception as exc:
                     store.event(session_id,"market_inputs_start_error",{"error_type":type(exc).__name__,
                         "core_forecasts_continue":True})
             startup_stage = "broker_session"
             broker = SchwabSession()
             startup_stage = "executor_setup"
             executor = IntradayAccountExecutor(datastore=root,store=store,broker=broker,local_symbols=symbols,
                 session_started_at=started,clock=clock,manual_authority=manual_authority,actor=pc,stopped=stopped.is_set,
                 diagnostic_session_id=session_id)
         except BaseException as exc:
             diagnostics = _startup_failure_evidence(exc, stage=startup_stage)
             cleanup_diagnostics = None
             if market_collector is not None:
                 try:
                     market_collector.close()
                 except Exception as cleanup_exc:
                     cleanup_diagnostics = _startup_failure_evidence(cleanup_exc, stage="market_inputs_close")
             stopped.set()
             status("STOPPED" if isinstance(exc,KeyboardInterrupt) else "FAILED",
                    stop_reason="manual_stop" if isinstance(exc,KeyboardInterrupt) else "startup_failure",
                    error_type=type(exc).__name__,broker_orders_automatically_cancelled=False)
             failure = {"error_type":type(exc).__name__,
                        "message":"Startup interrupted" if isinstance(exc,KeyboardInterrupt) else "Startup failed",
                        "diagnostics":diagnostics}
             if cleanup_diagnostics is not None:
                 failure["cleanup_diagnostics"] = cleanup_diagnostics
             store.event(session_id,"manual_startup_stopped",failure)
             if isinstance(exc,KeyboardInterrupt):
                 return {"session_id":session_id,"status":"STOPPED"}
             raise
         status("CLOSING" if instant(clock()) >= close_at else "RUNNING")
         def market_input_work():
             """Optional feeds run independently; missing inputs never stop core work."""
             from .market_input_worker import run_market_input_worker
             run_market_input_worker(market_collector, clock=clock, stopped=stopped.is_set, pause=sleep,
                 reference_for=lambda value: latest_completed_reference(value, publication_offset_seconds=config.publication_offset_seconds),
                 event=lambda kind, value: store.event(session_id, kind, value))
         input_worker = threading.Thread(target=market_input_work,name="intraday-market-inputs",daemon=True)
         def forecast_work():
             try:
                 forecasting_loop(runner,histories=histories,provider=provider,journal=journal,queue=queue,
                                  stopped=stopped.is_set,clock=clock,pause=pause,close_at=close_at)
             except BaseException as exc:
                 if isinstance(exc, InterruptedError) and instant(clock()) >= close_at and not stopped.is_set():
                     store.event(session_id,"forecasting_closed", {"closed_at":close_at.isoformat(),
                         "final_candle_collection_continues":True})
                     return
                 diagnostics = _forecast_failure_evidence(exc)
                 if not (isinstance(exc,InterruptedError) and stopped.is_set()):
                     worker_errors.append({"worker":"forecast","error_type":type(exc).__name__,
                         "message":str(exc),"diagnostics":diagnostics})
                 stopped.set()
                 try:
                     store.event(session_id,"forecast_worker_stopped",{"error_type":type(exc).__name__,
                         "message":str(exc),"diagnostics":diagnostics})
                 except Exception as diagnostic_exc:
                     print(encoded({"event":"forecast_worker_stopped", "diagnostics":diagnostics,
                         "diagnostic_failure":_forecast_failure_evidence(diagnostic_exc)}),flush=True)
         worker = threading.Thread(target=forecast_work,name="intraday-manual-forecast",daemon=True)
         def score_work():
             try:
                 scoring_loop(store,histories=histories,provider=provider,journal=journal,session_id=session_id,
                              stopped=stopped.is_set,clock=clock,pause=pause,close_at=close_at,actor=pc)
             except BaseException as exc:
                 if isinstance(exc, InterruptedError) and (stopped.is_set() or instant(clock()) >= close_at):
                     return
                 record_scoring_worker_failure(exc, store=store, session_id=session_id,
                     worker_errors=worker_errors, stopped=stopped)
         scorer = threading.Thread(target=score_work,name="intraday-manual-scoring",daemon=True)
         def collection_completed(result):
             if stopped.is_set():
                 return
             scored = score_saved_session_outcomes(store, session_id=session_id, actor=pc, symbols=symbols,
                 as_of=clock(), stopped=stopped.is_set)
             store.event(session_id, "final_saved_outcomes_scored", scored)
             if stopped.is_set():
                 return
             final_collection_complete.set()
             stopped.set()
         def collect_work():
             try:
                 collection_loop(store, histories=histories, provider=provider, journal=journal, symbols=symbols,
                     session_id=session_id, started_at=started, close_at=close_at,
                     publication_offset_seconds=config.publication_offset_seconds,
                     population_contract=config.population_contract,
                     clock=clock, stopped=stopped.is_set, pause=pause, on_completed=collection_completed)
             except BaseException as exc:
                 if isinstance(exc, InterruptedError) and stopped.is_set():
                     return
                 diagnostics = _storage_failure_evidence(exc)
                 failure = {"error_type":type(exc).__name__,"message":str(exc),"diagnostics":diagnostics}
                 worker_errors.append({"worker":"collection",**failure})
                 stopped.set()
                 try:
                     store.event(session_id,"collection_worker_stopped",failure)
                 except Exception as diagnostic_exc:
                     print(encoded({"event":"collection_worker_stopped", "diagnostics":diagnostics,
                         "diagnostic_failure":_storage_failure_evidence(diagnostic_exc)}),flush=True)
         collector = threading.Thread(target=collect_work,name="intraday-manual-candles",daemon=True)
         if market_collector is not None:
             input_worker.start()
         worker.start()
         scorer.start()
         collector.start()
         print(f"{pc} 15m manual session running. New predictions can submit real orders. Ctrl-C stops this worker; resting orders retain their broker identities.",flush=True)
         next_recovery = instant(clock())
         closing_announced = False
         manual_stop_requested = False
         try:
             while not stopped.is_set():
                 if instant(clock()) >= close_at:
                     status("CLOSING", broker_orders_automatically_cancelled=False,
                            waiting_for_final_candles=True)
                     if not closing_announced:
                         store.event(session_id,"market_close_collection_pending", {
                             "closed_at":close_at.isoformat(), "final_reference_at":(close_at-STEP).isoformat(),
                             "symbols":list(symbols), "new_forecasts_and_orders_disabled":True})
                         closing_announced = True
                     sleep(1)
                     continue
                 status("RUNNING")
                 for forecast in queue.due(clock()):
                     # A prior symbol in this snapshot may have just received a
                     # longer provider wait. No later symbol bypasses that wait.
                     if instant(clock()) >= close_at or not queue.broker_due(clock()):
                         break
                     try:
                         result = executor.step(forecast)
                         store.event(session_id,"execution_step",result,symbol=forecast["symbol"])
                         print(json.dumps({"event":"execution_disposition","symbol":forecast["symbol"],
                             **{key:result.get(key) for key in ("side","desired_quantity","adjusted_quantity",
                                 "disposition","submission_status","submitted_quantity","filled_quantity")}}),flush=True)
                         disposition = result["disposition"]
                         if disposition == "previous_intention_reconciliation" or result["evidence"].get("proven_unsent_retry_eligible"):
                             # Missing original order identity is local evidence,
                             # not a provider cooldown for every other symbol.
                             # Keep that commitment and retry only this forecast.
                             unknown_without_broker_wait = (
                                 disposition == "previous_intention_reconciliation"
                                 and result["evidence"].get("reason_code") == "EXACT_BROKER_ORDER_ID_UNAVAILABLE"
                                 and result["evidence"].get("retry_after_seconds") is None
                                 and not result["evidence"].get("proven_unsent_retry_eligible"))
                             queue.defer(forecast["forecast_id"],now=clock(),
                                 seconds=result["evidence"].get("retry_after_seconds") or 3,
                                 broker_wait=not unknown_without_broker_wait)
                         elif disposition == "submission_recovery_required":
                             # UNKNOWN is never requeued for submission. Status
                             # recovery and other symbols still honor its wait.
                             queue.broker_wait(now=clock(),seconds=result["evidence"].get("retry_after_seconds") or 3)
                             queue.complete(forecast["forecast_id"],disposition)
                         elif result["kind"] == "sizing_unavailable":
                             if (disposition == "quote_stale_or_future"
                                     and instant(clock()) < instant(forecast["target_close"])):
                                 # No desired quantity exists yet. Retain the failed
                                 # observation and retry fresh evidence for this
                                 # signal; the executor still enforces its expiry.
                                 queue.defer(forecast["forecast_id"],now=clock(),
                                     seconds=3,broker_wait=False)
                             else:
                                 queue.complete(forecast["forecast_id"],"sizing_unavailable")
                         else:
                             queue.complete(forecast["forecast_id"],disposition)
                     except Exception as exc:
                         delay = retry_delay(exc,clock())
                         queue.defer(forecast["forecast_id"],now=clock(),seconds=delay,broker_wait=True)
                         store.event(session_id,"execution_retry",{"forecast_id":forecast["forecast_id"],
                             "error_type":type(exc).__name__,"message":str(exc),"retry_after_seconds":delay,
                             "diagnostics":execution_failure_evidence(exc)},symbol=forecast["symbol"])
                         break
                 if instant(clock()) < close_at and instant(clock()) >= next_recovery and queue.broker_due(clock()):
                     try:
                         executor.recover()
                         delay = 3
                     except Exception as exc:
                         delay = retry_delay(exc,clock())
                         queue.broker_wait(now=clock(),seconds=delay)
                         store.event(session_id,"order_recovery_retry",{"error_type":type(exc).__name__,
                             "message":str(exc),"retry_after_seconds":delay,
                             "diagnostics":execution_failure_evidence(exc)})
                     next_recovery = instant(clock()) + timedelta(seconds=delay)
                 sleep(1)
         except KeyboardInterrupt:
             manual_stop_requested = True
             stopped.set()
         except BaseException as exc:
             worker_errors.append({"worker":"execution","error_type":type(exc).__name__,"message":str(exc)})
             raise
         finally:
             stopped.set()
             if market_collector is not None:
                 market_collector.close()
             stop_reason = ("worker_failure" if worker_errors else
                            "market_close" if final_collection_complete.is_set() and not manual_stop_requested else "manual_stop")
             status("STOPPING",broker_orders_automatically_cancelled=False,
                    stop_reason=stop_reason)
             print("15m order authority stopped. Waiting for active computation to finish; pending broker identities are retained.",flush=True)
             while worker.is_alive() or scorer.is_alive() or collector.is_alive() or input_worker.is_alive():
                 worker.join(timeout=1)
                 scorer.join(timeout=1)
                 collector.join(timeout=1)
                 if input_worker.is_alive():
                     input_worker.join(timeout=1)
                 status("STOPPING",broker_orders_automatically_cancelled=False,
                        stop_reason=stop_reason)
             stop_reason = ("worker_failure" if worker_errors else
                            "market_close" if final_collection_complete.is_set() and not manual_stop_requested else "manual_stop")
             status("FAILED" if worker_errors else "STOPPED",broker_orders_automatically_cancelled=False,
                    stop_reason=stop_reason,worker_errors=worker_errors)
             store.event(session_id,"manual_session_stopped",{"pending_order_identity_preserved":True,
                         "stop_reason":stop_reason,"worker_errors":worker_errors})
         return {"session_id":session_id,"status":"FAILED" if worker_errors else "STOPPED", "stop_reason":stop_reason}
 
 
