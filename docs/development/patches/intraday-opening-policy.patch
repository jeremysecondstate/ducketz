 def _symbol_exception_diagnostics(exc):
     """Bounded causal locations, never locals, source lines or nested messages."""
     chain, seen = [], set()
     current, relation = exc, "raised"
     while current is not None and id(current) not in seen and len(chain) < 6:
         seen.add(id(current))
         frames, count = deque(maxlen=8), 0
         trace = current.__traceback__
         while trace is not None:
             code = trace.tb_frame.f_code
             basename = code.co_filename.replace("\\", "/").rsplit("/", 1)[-1]
             frames.append({"file": re.sub(r"[^A-Za-z0-9_.-]", "_", basename)[:96],
                            "function": re.sub(r"[^A-Za-z0-9_<>.]", "_", code.co_name)[:96],
                            "line": trace.tb_lineno})
             count += 1
             trace = trace.tb_next
         item = {"type": re.sub(r"[^A-Za-z0-9_]", "_", type(current).__name__)[:96],
                 "relation": relation, "frames": list(frames), "frames_truncated": count > len(frames)}
         if isinstance(current, OSError):
             # Numeric OS categories distinguish sharing contention from denied
             # permissions without exposing filenames or authenticated messages.
             for name in ("errno", "winerror"):
                 code = getattr(current, name, None)
                 if type(code) is int and 0 <= code <= 0x7fffffff:
                     item[name] = code
         if isinstance(current, sqlite3.Error):
             code = getattr(current, "sqlite_errorcode", None)
             name = getattr(current, "sqlite_errorname", None)
             if type(code) is int and 0 <= code <= 0x7fffffff:
                 item["sqlite_errorcode"] = code
             if isinstance(name, str) and re.fullmatch(r"SQLITE_[A-Z0-9_]{1,64}", name):
                 item["sqlite_errorname"] = name
         chain.append(item)
         if current.__cause__ is not None:
             current, relation = current.__cause__, "cause"
         elif not current.__suppress_context__:
             current, relation = current.__context__, "context"
         else:
             current = None
     return {"schema_version": "intraday-symbol-exception-v1", "exception_chain": chain,
             "chain_truncated": current is not None}
 
 
 def _dataset_scope(value):
     if not isinstance(value, dict) or not {"synthetic_policy", "lookback_days"} <= value.keys():
         raise ContractError("Frozen dataset scope is invalid")
     scope = {"synthetic_policy": value.get("synthetic_policy"), "lookback_days": value.get("lookback_days")}
     if value.get("population_contract"):
         scope["population_contract"] = value["population_contract"]
     if (not isinstance(scope["synthetic_policy"], str) or scope["synthetic_policy"] not in {"include", "exclude"} or
             scope["lookback_days"] is not None and
             (type(scope["lookback_days"]) is not int or scope["lookback_days"] <= 0)):
         raise ContractError("Frozen dataset scope is invalid")
     return scope
 
 
 def _frozen_supervised_policy(saved, *, symbols):
     policy = saved.get("supervised_model_policy")
     if not isinstance(policy, dict):
         raise ContractError("Supervised cycle is missing its frozen model policy")
     evidence = {key: value for key, value in policy.items() if key != "sha256"}
     if digest(evidence) != policy.get("sha256"):
         raise ContractError("Frozen supervised model policy hash changed")
     if "dataset_scope_by_symbol" not in policy:
         # A pre-scope cycle already used its original ResearchConfig population.
         # Its unfinished symbols must use that same population, including when
         # active legacy policies now derive a different scope for new cycles.
         configuration = saved.get("configuration")
         if not isinstance(configuration, dict):
             raise ContractError("Legacy supervised cycle is missing its original dataset configuration")
         scope = _dataset_scope(configuration)
         return {**policy, "dataset_scope_by_symbol": {symbol: dict(scope) for symbol in symbols}}
     if not isinstance(policy["dataset_scope_by_symbol"], dict):
         raise ContractError("Frozen supervised cycle dataset scopes are invalid")
     for symbol in symbols:
         if symbol not in policy["dataset_scope_by_symbol"]:
             raise ContractError("Frozen supervised cycle is missing a symbol dataset scope")
         _dataset_scope(policy["dataset_scope_by_symbol"][symbol])
     return policy
 
 
 def _supervised_cycle_policy(store, cycle_id, *, pc, symbols, configuration,
                              selected_config_path=None, selected_as_of=None, use_model_policy=True,
                              model_policy_root=None):
     """Freeze selected specs, their policy identities and populations per cycle."""
     with store.connect() as db:
         row = db.execute("SELECT payload FROM cycles WHERE id=?", (cycle_id,)).fetchone()
     if row:
         saved = json.loads(row[0])
         if saved.get("supervised_model_policy") is None and not use_model_policy:
             return None
         return _frozen_supervised_policy(saved, symbols=symbols)
     from .data import FEATURE_NAMES
     from .model_policy import load_active_policy
     policy_root = Path(model_policy_root) if model_policy_root is not None else store.path.parent / "supervision"
     policy = {"pc": pc, "feature_names": list(FEATURE_NAMES), "models_by_symbol": {},
               "dataset_scope_by_symbol": {}, "policy_identities_by_symbol": {}}
     default_scope = _dataset_scope(configuration)
     selections = {}
     if selected_config_path is not None:
         from .selected_config import load_selected_config
         def selected_error(symbol, exc):
             store.event(cycle_id, "selected_configuration_error",
                 {"error_type": type(exc).__name__, "message": str(exc),
                  "configuration_used": "existing_own_policy_or_configured_defaults"}, symbol=symbol)
         try:
             selections = load_selected_config(selected_config_path, pc=pc, symbols=symbols,
                 source_dataset=configuration["source_dataset"], as_of=selected_as_of,
                 on_error=selected_error)
         except (OSError, ValueError, KeyError, TypeError) as exc:
             selected_error(None, exc)
         if selections:
             policy["selected_config_by_symbol"] = selections
     if not selections and not use_model_policy:
         return None
     for symbol in symbols:
         entry = selections.get(symbol)
         if entry is not None:
             policy["models_by_symbol"][symbol] = entry["models"]
             policy["dataset_scope_by_symbol"][symbol] = _dataset_scope(entry)
             if configuration.get("population_contract"):
                 policy["dataset_scope_by_symbol"][symbol]["population_contract"] = configuration["population_contract"]
             policy["policy_identities_by_symbol"][symbol] = entry["selection_id"]
             # The explicitly chosen own manifest supplies this cycle. A second
             # policy stays intact and is reported without becoming a wait or gate.
             other = policy_root / "active" / f"{pc}-{symbol}.json"
             if other.is_file():
                 details = {"selected_manifest": str(selected_config_path),
                            "selection_id": entry["selection_id"], "other_policy_path": str(other),
                            "policy_used": "selected_manifest", "other_policy_preserved": True}
                 try:
                     other_value = json.loads(other.read_text(encoding="utf-8"))
                     details["other_policy_newer"] = instant(other_value["installed_at"]) > instant(entry["selected_at"])
                 except (OSError, ValueError, KeyError, TypeError):
                     details["other_policy_time_unknown"] = True
                 store.event(cycle_id, "selected_configuration_precedence", details, symbol=symbol)
             continue
         selected = (load_active_policy(policy_root, pc=pc, symbol=symbol,
                                        feature_names=FEATURE_NAMES) if use_model_policy else None)
         policy["models_by_symbol"][symbol] = [asdict(spec) for spec in selected["models"]] if selected else None
         policy["dataset_scope_by_symbol"][symbol] = _dataset_scope(selected["dataset_scope"] if selected else default_scope)
         if configuration.get("population_contract"):
             policy["dataset_scope_by_symbol"][symbol]["population_contract"] = configuration["population_contract"]
         policy["policy_identities_by_symbol"][symbol] = selected["sha256"] if selected else None
     policy["sha256"] = digest(policy)
     return policy
 
 
 class ShadowRunner:
     def __init__(self, *, store, pc, symbols, config=None, artifact_root=None, clock=utcnow,
                  trainer=None, dataset_builder=None, stopped=lambda: False, selected_config_path=None,
                  prepared_source=None, datastore=None, forecast_preparer=None):
         self.store = store
         self.pc = pc
         self.symbols = tuple(symbols)
         if not self.symbols or len(set(self.symbols)) != len(self.symbols):
             raise ContractError("A nonempty unique local symbol scope is required")
         self.config = (config or ResearchConfig()).validate()
         self.artifact_root = Path(artifact_root) if artifact_root else self.store.path.parent / "models"
         self.clock = clock
         self.trainer = trainer
         self.dataset_builder = dataset_builder
         self.stopped = stopped
         # A split model worker receives only an already verified immutable
         # snapshot. It has no reason to open a market-data provider or rebuild
         # historical features on the consumer's later information clock.
         self.prepared_source = prepared_source
         self.forecast_preparer = forecast_preparer
         self.datastore = Path(datastore) if datastore is not None else self.store.path.parent.parent
         self.model_policy_root = (self.datastore / "intraday/supervision" if datastore is not None else
                                   self.store.path.parent / "supervision")
         self.selected_config_path = (Path(selected_config_path) if selected_config_path is not None else
                                      self.datastore / "intraday/model-supervision/active.json" if datastore is not None else
                                      self.store.path.parent / "model-supervision/active.json")
         from ml.market_provenance import capture_runtime
         from . import data, models, coverage, feature_support
         self.market_input_store = None
         if self.config.market_inputs_enabled and prepared_source is None:
             from .market_inputs import MarketInputStore
             self.market_input_store = MarketInputStore(self.datastore)
         self.runtime_provenance = capture_runtime(
             [__name__, data.__name__, models.__name__, coverage.__name__, feature_support.__name__,
              "ml.intraday.live_session", "ml.intraday.store", "ml.intraday.market_inputs",
              "ml.intraday.market_input_research", "ml.intraday.market_input_schwab_stream",
              "ml.intraday.market_input_stream", "ml.intraday.historical_market_inputs",
              "ml.intraday.provider_recovery", *_SPLIT_SOURCE_MODULES],
             object_root=self.artifact_root / "source-objects")
 
     def prepare_cycle(self, histories, *, reference_at, mode="live", cutoff=None, experiment="primary",
                       acquisition=None, on_prepared=None, retry_symbols=None):
         """Prepare each own-symbol snapshot without fitting or issuing a forecast.
 
         A complete symbol is handed off immediately. Partial preparation never
         claims a completed forecast cycle, and retries keep the first frozen
         recipe, causal cutoff, observations and target unchanged.
         """
         if self.prepared_source is not None:
             raise ContractError("A snapshot consumer cannot act as a data producer")
         return self.run_cycle(histories, reference_at=reference_at, mode=mode, cutoff=cutoff,
             experiment=experiment, acquisition=acquisition, retry_symbols=retry_symbols,
             allow_execution=False, _prepare_only=True, _on_prepared=on_prepared)
 
     def run_cycle(self, histories, *, reference_at, mode="shadow", cutoff=None, experiment="primary",
                   acquisition=None, intent_by_symbol=None, on_published=None, retry_symbols=None,
                   allow_execution=True, _prepare_only=False, _on_prepared=None):
         """Publish each complete symbol independently. Failure/restart never reissues.
 
         A research invocation uses explicit worker count, no deadline cancellation,
