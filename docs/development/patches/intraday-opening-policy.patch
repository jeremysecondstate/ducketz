         with sqlite3.connect(self.path) as db:
             row = db.execute("SELECT id FROM predictions WHERE slot=?",
                              (encoded([symbol, reference_at, TARGET_VERSION]),)).fetchone()
         return self.get(row[0]) if row else None
 
