         with sqlite3.connect(self.path) as db:
             row = db.execute("SELECT payload FROM predictions WHERE id=?", (prediction_id,)).fetchone()
         if row is None:
             raise ContractError("Unknown prediction")
         return Prediction(**json.loads(row[0])).validate()
 
