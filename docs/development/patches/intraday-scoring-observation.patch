+"""Preserve scoring eligibility without rebuilding the same recovery proof twice."""
+from __future__ import annotations
+
+from .coverage import RECOVERY_POPULATION_CONTRACT
+from .data import completed_15m_observation, synthetic_continuity_verified
+
+
+def completed_scoring_observation(candle):
+    """Require both completed-quarter and synthetic-continuity evidence.
+
+    Recovery observations use the same complete validator for both conditions.
+    Its successful result already proves continuity, so retain that result for
+    this call only. Other populations keep their separate original checks.
+    """
+    if not completed_15m_observation(candle):
+        return False
+    if candle.get("population_contract") == RECOVERY_POPULATION_CONTRACT:
+        return True
+    return synthetic_continuity_verified(candle)
