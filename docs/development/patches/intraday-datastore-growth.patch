         missing = [symbol for symbol in cycle["symbols"] if symbol not in published]
         failures = dict(cycle.get("failures", {}))
         # The failure event is durable even if a crash preceded the cycle-map
         # update. Latest events override that possibly older summary.
         failures.update(recorded_symbol_failures(store, identity))
         due = [s for s in missing if (
             cycle.get("status") == "running" and s not in failures
         ) or (failures.get(s, {}).get("retryable") is True
               and instant(failures[s]["retry_at"]) <= instant(now))]
         if due:
             result.append((identity, cycle, due))
     return sorted(result, key=lambda item: (
         item[1].get("last_recovery_attempt_at", item[1].get("completed_at", item[1]["started_at"])),
         item[1]["reference_at"]))
 
 
 def _forecast_failure_evidence(exc):
     """Bounded local code locations and SQLite codes, without private messages."""
     from collections import deque
 
     chain, seen = [], set()
     current = exc
     while current is not None and id(current) not in seen and len(chain) < 8:
         seen.add(id(current))
         frames = deque(maxlen=8)
         trace = current.__traceback__
         while trace is not None:
             code = trace.tb_frame.f_code
             frames.append({"file": code.co_filename.replace("\\", "/").rsplit("/", 1)[-1][:120],
                            "function": code.co_name[:120], "line": trace.tb_lineno})
             trace = trace.tb_next
         item = {"error_type": type(current).__name__[:80], "frames": list(frames)}
         code = getattr(current, "sqlite_errorcode", None)
         name = getattr(current, "sqlite_errorname", None)
         if (isinstance(current, sqlite3.Error) and type(code) is int and type(name) is str
                 and name.startswith("SQLITE_") and getattr(sqlite3, name, None) == code):
             item.update(sqlite_errorcode=code, sqlite_errorname=name)
         chain.append(item)
         current = (current.__cause__ if current.__cause__ is not None else
                    None if current.__suppress_context__ else current.__context__)
     return {"exception_chain": chain, "root_cause": chain[-1],
             "exception_chain_truncated": current is not None}
 
 
 def _retry_forecast_storage(action, *, store, session_id, operation, stopped, pause):
     """Resume the exact interrupted cycle operation after transient contention.
 
     Each action opens fresh store transactions. Repeating run_cycle reuses its
     immutable outputs and original reference; repeating finalization never
     retrains. Other storage errors retain their original failure path.
     """
     retries, failure = 0, None
     while not stopped():
         try:
             result = action()
         except sqlite3.OperationalError as exc:
             code = getattr(exc, "sqlite_errorcode", None)
             if type(code) is not int or code & 255 != sqlite3.SQLITE_BUSY:
                 raise
             retries += 1
             failure = _forecast_failure_evidence(exc)
             # The same busy database cannot be required to save its own error.
             print(encoded({"event": "forecast_storage_contention", "operation": operation,
                            "retry_count": retries, "diagnostics": failure}), flush=True)
             pause(1)
             continue
         if retries:
             evidence = {"operation": operation, "retry_count": retries,
                         "last_failure": failure, "operation_returned_normally": True}
             try:
                 store.event(session_id, "forecast_storage_retry_completed", evidence)
             except Exception as exc:
                 print(encoded({"event": "forecast_storage_retry_diagnostic_unavailable",
                                "operation": operation, "diagnostics": _forecast_failure_evidence(exc)}),
                       flush=True)
         return result
     raise InterruptedError("Manual session stopped; forecast storage continuation retained")
 
 
 def forecasting_loop(runner, *, histories, provider, journal, queue, stopped,
                      clock=utcnow, pause=time.sleep, close_at=None, renewal=None):
     """New quarters receive a turn before one due recovery symbol.
 
     Only missing data prerequisites retry automatically. Already issued model
     outputs remain immutable, and older recovered outputs never enter execution.
     No missed-quarter forecast or older fitted model is invented.
     """
     saved = _session_cycles(runner.store, queue.session_id)
     saved_last = max((instant(c["reference_at"]) for _, c in saved), default=None)
     continuation = renewal.state if renewal is not None else {}
     last = instant(continuation["last_reference"]) if continuation.get("last_reference") else saved_last
     recovery_due = bool(continuation.get("recovery_due", False))
     def completed_pass():
         if renewal is not None:
             renewal.checkpoint({"last_reference": last.isoformat() if last else None,
                                 "recovery_due": recovery_due},
                                (instant(clock()) + timedelta(seconds=1)).isoformat())
         pause(1)
     storage_stopped = lambda: stopped() or (close_at is not None and instant(clock()) >= instant(close_at))
     while not stopped():
         if close_at is not None and instant(clock()) >= instant(close_at):
             return
         newest = latest_completed_reference(clock(), publication_offset_seconds=runner.config.publication_offset_seconds)
         retry_symbols = None
         recovery_symbol = None
         # A long new-quarter pass can cross the next boundary every time.
         # Reserve one symbol's recovery turn so those boundaries cannot starve
         # already saved scientific work. The next fresh quarter follows it.
         fair = _pending_cycle_passes(runner.store, queue.session_id, clock()) if recovery_due else []
         if fair:
             _, cycle, due = fair[0]
             symbols = cycle["symbols"]
             previous = cycle.get("last_recovery_symbol")
             start = symbols.index(previous) + 1 if previous in symbols else 0
             retry_symbols = [next(symbol for symbol in symbols[start:] + symbols[:start] if symbol in due)]
             recovery_symbol = retry_symbols[0]
             reference = instant(cycle["reference_at"])
             recovery_due = False
         elif last is None or newest > last:
             reference = newest
             if last is not None and reference > last + STEP:
                 runner.store.event(queue.session_id, "missed_cycle_boundaries",
                     {"previous_reference":last.isoformat(),"next_reference":reference.isoformat(),
                      "missed_count":int((reference-last)/STEP)-1,"policy":"latest_completed_no_backlog_orders"})
             last = reference
             if not eligible_reference(reference):
                 runner.store.event(queue.session_id,"closed_or_unspecified_edge",
                                    {"reference_at":reference.isoformat(),"orders_submitted":0})
                 completed_pass(); continue
         else:
             pending = _pending_cycle_passes(runner.store, queue.session_id, clock())
             if not pending:
                 completed_pass(); continue
             _, cycle, retry_symbols = pending[0]
             reference = instant(cycle["reference_at"])
         incoming = LiveHistories(histories=histories,provider=provider,store=runner.store,journal=journal,
                                 reference_at=reference,clock=clock,sleep=pause,bounded=True,
                                 stopped=lambda: stopped() or (close_at is not None and instant(clock()) >= instant(close_at)),
                                 reuse_saved=True,population_contract=getattr(runner.config,"population_contract",None),
                                 restore_eagerly=False)
         if close_at is not None and instant(clock()) >= instant(close_at):
             return
         cycle_attempt = 0
         def publish_retry(forecast):
             if reference != latest_completed_reference(
                     clock(), publication_offset_seconds=runner.config.publication_offset_seconds):
                 runner.store.event(forecast["cycle_id"], "forecast_execution_blocked",
                     {"forecast_id":forecast["forecast_id"], "reason":"recovered_older_cycle",
                      "forecast_preserved":True},symbol=forecast["symbol"])
                 return
             queue.enqueue(forecast)
         def run_cycle_attempt():
             nonlocal cycle_attempt
             cycle_attempt += 1
             return runner.run_cycle(incoming,reference_at=reference,mode="live",experiment=queue.session_id,
                          on_published=queue.enqueue if cycle_attempt == 1 else publish_retry,
                          acquisition={"kind":"existing_databento_exact_interval"},
                          retry_symbols=retry_symbols,allow_execution=reference == latest_completed_reference(
                              clock(), publication_offset_seconds=runner.config.publication_offset_seconds))
         result = _retry_forecast_storage(run_cycle_attempt,
             store=runner.store,session_id=queue.session_id,operation="run_cycle",
             stopped=storage_stopped,pause=pause)
         if result and result.get("cycle_id"):
             if stopped():
                 return
             completed_at = instant(clock()).isoformat()
             update = {"last_recovery_attempt_at":completed_at}
             if recovery_symbol is not None:
                 update["last_recovery_symbol"] = recovery_symbol
             _retry_forecast_storage(
                 lambda: runner.store.update_cycle(result["cycle_id"], update),
                 store=runner.store,session_id=queue.session_id,operation="cycle_finalization",
                 stopped=storage_stopped,pause=pause)
         if retry_symbols is None:
             recovery_due = True
         completed_pass()
 
 
 def scoring_loop(store, *, histories, provider, journal, session_id, stopped,
                  clock=utcnow, pause=time.sleep, close_at=None, actor="Atlas", renewal=None):
     """Fetch exact due outcomes independently, including after the last entry.
 
     Acquisition retry evidence is durable. This never submits an order, changes
     an issued prediction or writes corrections into its original input snapshot.
     Local copies of the history mapping keep scoring out of the training writer.
     """
     from .data import completed_15m_observation, synthetic_continuity_verified
     audited = set(renewal.state.get("audited", ())) if renewal is not None else set()
     interrupted = lambda: stopped() or (close_at is not None and instant(clock()) >= instant(close_at))
     def storage(operation, action):
         return retry_scoring_storage(action, store=store, session_id=session_id,
             operation=operation, stopped=interrupted, pause=pause)
     def observe(operation, forecast, **evidence):
         observed_at = clock()
         # Another outcome writer may commit newer evidence during contention.
         # Keep the captured observation time and retain that validated revision.
         return storage(operation, lambda: store.observe(
             forecast, as_of=observed_at, skip_newer=True, **evidence))
     def drain_retained_targets():
         if interrupted():
             return
         as_of = clock()
         ready = storage("retained_targets", lambda: list(store.retained_session_scoring_targets(
             pc=actor, session_id=session_id, as_of=as_of, stopped=interrupted)))
         for forecast, observed in ready:
             if interrupted():
                 return
             observe("observe_retained_target", forecast, candle=observed)
     while not stopped():
         if close_at is not None and instant(clock()) >= instant(close_at):
             return
         drain_retained_targets()
         if stopped() or (close_at is not None and instant(clock()) >= instant(close_at)):
             return
         observed_candidates = {}
         for candle in storage("observed_candles", lambda: list(store.observed_candles())):
             if not synthetic_continuity_verified(candle):
                 key=digest(candle)
                 if key not in audited:
                     storage("audit_synthetic_outcome", lambda: store.event(
                         session_id,"unverified_synthetic_outcome_requires_audit",
                         {"candle_hash":key,"immutable_original_retained":True},symbol=candle["symbol"]))
                     audited.add(key)
                 continue
             if not completed_15m_observation(candle) or instant(candle["available_at"]) > instant(clock()):
                 continue
             observed_candidates.setdefault((candle["symbol"],instant(candle["opened_at"])), []).append(candle)
         as_of = clock()
         forecasts = storage("scoring_forecasts", lambda: list(store.scoring_forecasts(
             pc=actor, observed_candidates=observed_candidates, as_of=as_of, stopped=interrupted)))
         for forecast in forecasts:
             if stopped():
                 return
             if close_at is not None and instant(clock()) >= instant(close_at):
                 return
             drain_retained_targets()
             if stopped() or (close_at is not None and instant(clock()) >= instant(close_at)):
                 return
             if forecast["mode"] != "live" or instant(forecast["target_close"]) > instant(clock()):
                 continue
             revisions = storage("outcome_revisions", lambda: list(store.revisions(forecast["forecast_id"])))
             candidates = observed_candidates.get((forecast["symbol"],instant(forecast["target_open"])), [])
             observed = next((row for row in reversed(candidates)
                 if row.get("population_contract") == forecast.get("population_contract")
                 and all(not forecast.get(field) or row.get(field) == forecast[field]
                        for field in ("source_dataset", "source_id"))), None)
             if observed is not None and instant(observed["available_at"]) <= instant(clock()):
                 observe("observe_saved_target", forecast, candle=observed)
                 continue
             if revisions and revisions[-1]["status"] in {"scored", "synthetic", "unscorable"}:
                 continue
             symbol = forecast["symbol"]
             if symbol not in histories:
                 continue
             incoming = LiveHistories(histories={symbol:histories[symbol]},provider=provider,store=store,journal=journal,
                 reference_at=forecast["target_open"],clock=clock,sleep=pause,bounded=True,
                 stopped=lambda: stopped() or (close_at is not None and instant(clock()) >= instant(close_at)),
                 reuse_saved=True,population_contract=forecast.get("population_contract") or "legacy",
                 restore_eagerly=False)
             incoming.bind_cycle("score:" + forecast["forecast_id"])
             try:
                 history = incoming.get(symbol)
                 match = history.frame.loc[history.frame.opened_at.eq(instant(forecast["target_open"]))]
                 match = match.loc[[completed_15m_observation(row, from_frame=True) and synthetic_continuity_verified(row)
                     and (row.get("population_contract") if isinstance(row.get("population_contract"), str) else None)
                         == forecast.get("population_contract")
                     and instant(row["available_at"]) <= instant(clock())
                     and row.get("availability_kind") == "actual"
                     and all(not forecast.get(field) or row.get(field) == forecast[field]
                             for field in ("source_dataset", "source_id"))
                     for row in match.to_dict("records")]]
                 if match.empty:
                     raise ContractError("Exact target interval unavailable after acquisition")
                 match = match.sort_values("available_at")
                 from .runtime import _jsonable
                 observed = _jsonable(match.iloc[-1].to_dict())
             except SourceIntervalEmpty as exc:
                 storage("source_empty_event", lambda: store.event(
                     session_id,"target_source_empty",{"forecast_id":forecast["forecast_id"],
                     "evidence":exc.evidence,"no_market_wide_no_trade_claim":True},symbol=symbol))
                 observe("observe_source_empty", forecast,
                     unavailable_reason="covered_source_empty; no observed outcome price or market-wide no-trade proof")
             except InterruptedError:
                 if stopped() or (close_at is not None and instant(clock()) >= instant(close_at)):
                     return
                 raise
             except Exception as exc:
                 storage("scoring_retry_event", lambda: store.event(
                     session_id,"target_scoring_retry",{"forecast_id":forecast["forecast_id"],
                     "error_type":type(exc).__name__,"message":str(exc),
                     "diagnostics":scoring_failure_evidence(exc)},symbol=symbol))
             else:
                 observe("observe_acquired_target", forecast, candle=observed)
             finally:
                 drain_retained_targets()
         if renewal is not None:
             renewal.checkpoint({"audited": sorted(audited)},
                                (instant(clock()) + timedelta(seconds=3)).isoformat())
         pause(3)
 
 
 def score_saved_session_outcomes(store, *, session_id, actor, symbols, as_of, stopped=lambda: False):
     """Finalize persisted own outcomes using unchanged-original revision proofs."""
     from .final_scoring import score_saved_session_outcomes as finalize
     return finalize(store, session_id=session_id, actor=actor, symbols=symbols,
