 def with_local_data_policy(config, datastore):
     """Explicit private binding; historical forecasts retain their frozen policy."""
     from .coverage import load_data_policy
     if not (Path(datastore) / "intraday/data-policy.json").is_file():
         return config
     policy = load_data_policy(datastore)
     if not policy:
         return config
     if policy.get("source_dataset", config.source_dataset) != config.source_dataset:
         raise ContractError("Local data policy differs from configured source")
     return replace(config, population_contract=policy.get("population_contract"),
                    market_inputs_enabled=policy.get("market_inputs_enabled", False)).validate()
 
 
 def local_symbols(profile_path, watchlist_path, datastore):
     """Validate research membership without creating or activating trading state.
 
     Only the installed local profile and its exact watchlist bind research.
     Other trader configuration is outside this runtime.
     """
     profile = json.loads(Path(profile_path).read_text(encoding="utf-8"))
     watch = tuple(x.strip() for x in Path(watchlist_path).read_text(encoding="utf-8").splitlines()
                   if x.strip() and not x.lstrip().startswith("#"))
     machine = profile["machine"]
     symbols = tuple(profile["symbols"])
     if (profile.get("actor") not in {"Atlas", "Scout"} or
             {"Atlas": "pc-original", "Scout": "pc-new"}.get(profile.get("actor")) != machine or
             not symbols or len(set(symbols)) != len(symbols) or
             not watch or len(set(watch)) != len(watch) or set(watch) != set(symbols)):
         raise ContractError("Local profile and watchlist research membership disagree")
     pinned_watchlist = profile.get("symbol_profile_path")
     if not pinned_watchlist or Path(pinned_watchlist).resolve() != Path(watchlist_path).resolve():
         raise ContractError("Research requires the installed profile's exact local watchlist")
     return profile["actor"], symbols
 
 
 def _frame(history):
     return history.frame if hasattr(history, "frame") else history
 
 
 def _jsonable(value):
     if value is pd.NA or value is pd.NaT:
         return None
     if isinstance(value, dict):
         return {str(k): _jsonable(v) for k, v in value.items()}
     if isinstance(value, (list, tuple, np.ndarray, pd.Index)):
         return [_jsonable(v) for v in value]
     if isinstance(value, (datetime, pd.Timestamp)):
         return value.isoformat()
     if isinstance(value, np.generic):
         return _jsonable(value.item())
     if isinstance(value, float) and not np.isfinite(value):
         return None
     return value
 
 
 def _market_feature_migration(selected, current, base):
     """Portable specifications can refit changed context without claiming assessment.
 
     The price feature definitions stay ordered and exact. No fitted estimator or
     old input matrix is reused. Only paired, explicitly missing-aware context
     columns may differ; arbitrary feature mismatches remain errors.
     """
     base = list(base)
     def context(names):
         if list(names[:len(base)]) != base or len(set(names)) != len(names):
             return False
         suffix = list(names[len(base):])
         return len(suffix) % 2 == 0 and all(
             isinstance(name, str) and name.startswith("market_") and not name.endswith("__available")
             and suffix[index + 1] == name + "__available"
             for index, name in enumerate(suffix) if index % 2 == 0)
     return context(selected) and context(current)
 
 
 def resource_snapshot():
     """Own process and aggregate host metrics without inspecting other traders."""
     process = psutil.Process()
     cpu = process.cpu_times()
     return dict(process_rss_bytes=process.memory_info().rss, process_cpu_seconds=cpu.user + cpu.system,
                 system_available_memory_bytes=psutil.virtual_memory().available,
                 system_cpu_percent=psutil.cpu_percent(interval=None))
 
 def regime_measurements(snapshot):
     """Causal trailing observations; bins belong only to retrospective reporting."""
     rows=snapshot.get("inference",{}).get("snapshot",{}).get("candles",[])[-21:]
     if len(rows)<21:
         return {}
     close=np.asarray([float(r["close"]) for r in rows])
     changes=np.abs(np.diff(close))
     highs=np.asarray([float(r["high"]) for r in rows[1:]])
     lows=np.asarray([float(r["low"]) for r in rows[1:]])
     tr=np.maximum.reduce([highs-lows,np.abs(highs-close[:-1]),np.abs(lows-close[:-1])])
     span=float(highs.max()-lows.min())
     feature_map=dict(zip(snapshot["feature_names"],snapshot["inference_X"][0]))
     return {"volatility":feature_map.get("volatility20_observed"),
             "trend_strength":float(abs(close[-1]-close[0])/changes.sum()) if changes.sum() else 0.0,
             "choppiness":100*math.log10(float(tr.sum())/span)/math.log10(20) if span>0 and tr.sum()>0 else 100.0,
             "definition":"trailing20_observed_steps_efficiency_and_choppiness_v1"}
 
 
 def recorded_symbol_failures(store, cycle_id):
     """Latest immutable failure events also survive a missing cycle summary."""
     with store.connect() as db:
         rows=db.execute("SELECT symbol,payload FROM events WHERE cycle_id=? AND kind='symbol_failure' ORDER BY id",
                         (cycle_id,)).fetchall()
     return {symbol:json.loads(payload) for symbol,payload in rows}
 
 
 def _symbol_exception_diagnostics(exc):
     """Bounded causal locations, never locals, source lines or nested messages."""
     chain, seen = [], set()
     current, relation = exc, "raised"
     while current is not None and id(current) not in seen and len(chain) < 6:
         seen.add(id(current))
         frames, count = deque(maxlen=8), 0
         trace = current.__traceback__
         while trace is not None:
             code = trace.tb_frame.f_code
             basename = code.co_filename.replace("\\", "/").rsplit("/", 1)[-1]
             frames.append({"file": re.sub(r"[^A-Za-z0-9_.-]", "_", basename)[:96],
                            "function": re.sub(r"[^A-Za-z0-9_<>.]", "_", code.co_name)[:96],
                            "line": trace.tb_lineno})
             count += 1
             trace = trace.tb_next
         item = {"type": re.sub(r"[^A-Za-z0-9_]", "_", type(current).__name__)[:96],
                 "relation": relation, "frames": list(frames), "frames_truncated": count > len(frames)}
         if isinstance(current, OSError):
             # Numeric OS categories distinguish sharing contention from denied
             # permissions without exposing filenames or authenticated messages.
             for name in ("errno", "winerror"):
                 code = getattr(current, name, None)
                 if type(code) is int and 0 <= code <= 0x7fffffff:
                     item[name] = code
         if isinstance(current, sqlite3.Error):
             code = getattr(current, "sqlite_errorcode", None)
             name = getattr(current, "sqlite_errorname", None)
             if type(code) is int and 0 <= code <= 0x7fffffff:
                 item["sqlite_errorcode"] = code
             if isinstance(name, str) and re.fullmatch(r"SQLITE_[A-Z0-9_]{1,64}", name):
                 item["sqlite_errorname"] = name
         chain.append(item)
         if current.__cause__ is not None:
             current, relation = current.__cause__, "cause"
         elif not current.__suppress_context__:
             current, relation = current.__context__, "context"
         else:
             current = None
     return {"schema_version": "intraday-symbol-exception-v1", "exception_chain": chain,
             "chain_truncated": current is not None}
 
 
 def _dataset_scope(value):
     if not isinstance(value, dict) or not {"synthetic_policy", "lookback_days"} <= value.keys():
         raise ContractError("Frozen dataset scope is invalid")
     scope = {"synthetic_policy": value.get("synthetic_policy"), "lookback_days": value.get("lookback_days")}
     if value.get("population_contract"):
         scope["population_contract"] = value["population_contract"]
     if (not isinstance(scope["synthetic_policy"], str) or scope["synthetic_policy"] not in {"include", "exclude"} or
             scope["lookback_days"] is not None and
             (type(scope["lookback_days"]) is not int or scope["lookback_days"] <= 0)):
         raise ContractError("Frozen dataset scope is invalid")
     return scope
 
 
 def _frozen_supervised_policy(saved, *, symbols):
     policy = saved.get("supervised_model_policy")
     if not isinstance(policy, dict):
         raise ContractError("Supervised cycle is missing its frozen model policy")
     evidence = {key: value for key, value in policy.items() if key != "sha256"}
     if digest(evidence) != policy.get("sha256"):
         raise ContractError("Frozen supervised model policy hash changed")
     if "dataset_scope_by_symbol" not in policy:
         # A pre-scope cycle already used its original ResearchConfig population.
         # Its unfinished symbols must use that same population, including when
         # active legacy policies now derive a different scope for new cycles.
         configuration = saved.get("configuration")
         if not isinstance(configuration, dict):
             raise ContractError("Legacy supervised cycle is missing its original dataset configuration")
         scope = _dataset_scope(configuration)
         return {**policy, "dataset_scope_by_symbol": {symbol: dict(scope) for symbol in symbols}}
     if not isinstance(policy["dataset_scope_by_symbol"], dict):
         raise ContractError("Frozen supervised cycle dataset scopes are invalid")
     for symbol in symbols:
         if symbol not in policy["dataset_scope_by_symbol"]:
             raise ContractError("Frozen supervised cycle is missing a symbol dataset scope")
         _dataset_scope(policy["dataset_scope_by_symbol"][symbol])
     return policy
 
 
 def _supervised_cycle_policy(store, cycle_id, *, pc, symbols, configuration,
                              selected_config_path=None, selected_as_of=None, use_model_policy=True,
                              model_policy_root=None):
     """Freeze selected specs, their policy identities and populations per cycle."""
     with store.connect() as db:
         row = db.execute("SELECT payload FROM cycles WHERE id=?", (cycle_id,)).fetchone()
     if row:
         saved = json.loads(row[0])
         if saved.get("supervised_model_policy") is None and not use_model_policy:
             return None
         return _frozen_supervised_policy(saved, symbols=symbols)
     from .data import FEATURE_NAMES
     from .model_policy import load_active_policy
     policy_root = Path(model_policy_root) if model_policy_root is not None else store.path.parent / "supervision"
     policy = {"pc": pc, "feature_names": list(FEATURE_NAMES), "models_by_symbol": {},
               "dataset_scope_by_symbol": {}, "policy_identities_by_symbol": {}}
     default_scope = _dataset_scope(configuration)
     selections = {}
     if selected_config_path is not None:
         from .selected_config import load_selected_config
         def selected_error(symbol, exc):
             store.event(cycle_id, "selected_configuration_error",
                 {"error_type": type(exc).__name__, "message": str(exc),
                  "configuration_used": "existing_own_policy_or_configured_defaults"}, symbol=symbol)
         try:
             selections = load_selected_config(selected_config_path, pc=pc, symbols=symbols,
                 source_dataset=configuration["source_dataset"], as_of=selected_as_of,
                 on_error=selected_error)
         except (OSError, ValueError, KeyError, TypeError) as exc:
             selected_error(None, exc)
         if selections:
             policy["selected_config_by_symbol"] = selections
     if not selections and not use_model_policy:
         return None
     for symbol in symbols:
         entry = selections.get(symbol)
         if entry is not None:
             policy["models_by_symbol"][symbol] = entry["models"]
             policy["dataset_scope_by_symbol"][symbol] = _dataset_scope(entry)
             if configuration.get("population_contract"):
                 policy["dataset_scope_by_symbol"][symbol]["population_contract"] = configuration["population_contract"]
             policy["policy_identities_by_symbol"][symbol] = entry["selection_id"]
             # The explicitly chosen own manifest supplies this cycle. A second
             # policy stays intact and is reported without becoming a wait or gate.
             other = policy_root / "active" / f"{pc}-{symbol}.json"
             if other.is_file():
                 details = {"selected_manifest": str(selected_config_path),
                            "selection_id": entry["selection_id"], "other_policy_path": str(other),
                            "policy_used": "selected_manifest", "other_policy_preserved": True}
                 try:
                     other_value = json.loads(other.read_text(encoding="utf-8"))
                     details["other_policy_newer"] = instant(other_value["installed_at"]) > instant(entry["selected_at"])
                 except (OSError, ValueError, KeyError, TypeError):
                     details["other_policy_time_unknown"] = True
                 store.event(cycle_id, "selected_configuration_precedence", details, symbol=symbol)
             continue
         selected = (load_active_policy(policy_root, pc=pc, symbol=symbol,
                                        feature_names=FEATURE_NAMES) if use_model_policy else None)
         policy["models_by_symbol"][symbol] = [asdict(spec) for spec in selected["models"]] if selected else None
         policy["dataset_scope_by_symbol"][symbol] = _dataset_scope(selected["dataset_scope"] if selected else default_scope)
         if configuration.get("population_contract"):
             policy["dataset_scope_by_symbol"][symbol]["population_contract"] = configuration["population_contract"]
         policy["policy_identities_by_symbol"][symbol] = selected["sha256"] if selected else None
     policy["sha256"] = digest(policy)
     return policy
 
 
 class ShadowRunner:
     def __init__(self, *, store, pc, symbols, config=None, artifact_root=None, clock=utcnow,
                  trainer=None, dataset_builder=None, stopped=lambda: False, selected_config_path=None,
                  prepared_source=None, datastore=None, forecast_preparer=None):
         self.store = store
         self.pc = pc
         self.symbols = tuple(symbols)
         if not self.symbols or len(set(self.symbols)) != len(self.symbols):
             raise ContractError("A nonempty unique local symbol scope is required")
         self.config = (config or ResearchConfig()).validate()
         self.artifact_root = Path(artifact_root) if artifact_root else self.store.path.parent / "models"
         self.clock = clock
         self.trainer = trainer
         self.dataset_builder = dataset_builder
         self.stopped = stopped
         # A split model worker receives only an already verified immutable
         # snapshot. It has no reason to open a market-data provider or rebuild
         # historical features on the consumer's later information clock.
         self.prepared_source = prepared_source
         self.forecast_preparer = forecast_preparer
         self.datastore = Path(datastore) if datastore is not None else self.store.path.parent.parent
         self.model_policy_root = (self.datastore / "intraday/supervision" if datastore is not None else
                                   self.store.path.parent / "supervision")
         self.selected_config_path = (Path(selected_config_path) if selected_config_path is not None else
                                      self.datastore / "intraday/model-supervision/active.json" if datastore is not None else
                                      self.store.path.parent / "model-supervision/active.json")
         from ml.market_provenance import capture_runtime
         from . import data, models, coverage, feature_support
         self.market_input_store = None
         if self.config.market_inputs_enabled and prepared_source is None:
             from .market_inputs import MarketInputStore
             self.market_input_store = MarketInputStore(self.datastore)
         self.runtime_provenance = capture_runtime(
             [__name__, data.__name__, models.__name__, coverage.__name__, feature_support.__name__,
              "ml.intraday.live_session", "ml.intraday.store", "ml.intraday.market_inputs",
              "ml.intraday.market_input_research", "ml.intraday.market_input_schwab_stream",
              "ml.intraday.market_input_stream", "ml.intraday.historical_market_inputs",
              "ml.intraday.provider_recovery", *_SPLIT_SOURCE_MODULES],
             object_root=self.artifact_root / "source-objects")
 
     def prepare_cycle(self, histories, *, reference_at, mode="live", cutoff=None, experiment="primary",
                       acquisition=None, on_prepared=None, retry_symbols=None):
         """Prepare each own-symbol snapshot without fitting or issuing a forecast.
 
         A complete symbol is handed off immediately. Partial preparation never
         claims a completed forecast cycle, and retries keep the first frozen
         recipe, causal cutoff, observations and target unchanged.
         """
         if self.prepared_source is not None:
             raise ContractError("A snapshot consumer cannot act as a data producer")
         return self.run_cycle(histories, reference_at=reference_at, mode=mode, cutoff=cutoff,
             experiment=experiment, acquisition=acquisition, retry_symbols=retry_symbols,
             allow_execution=False, _prepare_only=True, _on_prepared=on_prepared)
 
     def run_cycle(self, histories, *, reference_at, mode="shadow", cutoff=None, experiment="primary",
                   acquisition=None, intent_by_symbol=None, on_published=None, retry_symbols=None,
                   allow_execution=True, _prepare_only=False, _on_prepared=None):
         """Publish each complete symbol independently. Failure/restart never reissues.
 
         A research invocation uses explicit worker count, no deadline cancellation,
         and no prior-model fallback. The primary runner always fits fresh models.
         Historical replay uses a separate simulated information clock and persists
         actual computation/recording time. It cannot masquerade as a live issue.
         """
         reference = instant(reference_at)
         if reference.minute % 15 or reference.second or reference.microsecond:
             raise ContractError("Reference must be a quarter-hour opening")
         if mode not in {"shadow", "live", "historical_replay"}:
             raise ContractError("Explicit shadow, live or historical_replay mode required")
         started = instant(self.clock())
         from ml.market_provenance import capture_runtime
         # Capture after manual-session acquisition adapters have loaded, for
         # every forecast cycle. Constructor-time source is not a deployment claim.
         self.runtime_provenance = capture_runtime([
             __name__, "ml.intraday.data", "ml.intraday.models", "ml.intraday.coverage",
             "ml.intraday.feature_support", "ml.intraday.live_session", "ml.intraday.store",
             "ml.intraday.market_inputs", "ml.intraday.market_input_stream",
             "ml.intraday.market_input_research", "ml.intraday.market_input_schwab_stream",
             "ml.intraday.historical_market_inputs", "ml.intraday.provider_recovery", *_SPLIT_SOURCE_MODULES],
             object_root=self.artifact_root / "source-objects")
         scheduled = reference + STEP + timedelta(seconds=self.config.publication_offset_seconds)
         training_cutoff = (instant(cutoff) if cutoff else started if mode in {"shadow", "live"} else
                            scheduled+timedelta(seconds=float((acquisition or {}).get("seconds",0))))
         if training_cutoff < reference + STEP or (mode in {"shadow", "live"} and training_cutoff > started):
             raise ContractError("Training cutoff cannot precede completion or be in the future")
         configuration = _jsonable(asdict(self.config))
         configuration_hash = digest(configuration)
         cycle_id = digest(dict(pc=self.pc,reference_at=reference.isoformat(),configuration_hash=configuration_hash,
                                mode=mode,experiment=experiment))
         from .models import DEFAULT_MODELS
         default_models = tuple(self.config.models) == DEFAULT_MODELS
         # Prepared snapshots already contain their exact original model policy.
         # A later active selection must not silently retune the consumer.
         use_model_policy = self.prepared_source is None and self.config.use_supervised_models and mode == "live"
         use_selected_manifest = self.prepared_source is None and mode in {"live", "shadow"} and default_models
         supervised_policy = (_supervised_cycle_policy(self.store, cycle_id, pc=self.pc, symbols=self.symbols,
             configuration=configuration, selected_as_of=training_cutoff,
             selected_config_path=self.selected_config_path if use_selected_manifest else None,
             use_model_policy=use_model_policy, model_policy_root=self.model_policy_root)
                              if use_model_policy or use_selected_manifest else None)
         if supervised_policy is not None and supervised_policy.get("selected_config_by_symbol"):
             # This overlay is excluded from the logical cycle identity. The
             # first begin_cycle writer owns it; retries reuse that frozen choice.
             configuration["selected_models_by_symbol"] = supervised_policy["selected_config_by_symbol"]
         initial = dict(pc=self.pc,symbols=list(self.symbols),reference_at=reference.isoformat(),mode=mode,
                        experiment=experiment,configuration_hash=configuration_hash,configuration=configuration,
                        supervised_model_policy=supervised_policy,
                        started_at=started.isoformat(),training_cutoff=training_cutoff.isoformat(),
                        candle_close=(reference+STEP).isoformat(),scheduled_acquisition=scheduled.isoformat(),
                        acquisition=acquisition or {},status="running",full_retrain=True,
                        runtime_provenance=self.runtime_provenance,
                        scheduling_policy="explicit_research_workers_no_timeout_no_fallback",
                        overrun_policy="latest_completed_no_backlog_orders" if mode == "live" else
                                       "record_overrun_no_automatic_live_execution")
         saved = self.store.begin_cycle(cycle_id,initial)
         supervised_policy = (_frozen_supervised_policy(saved, symbols=self.symbols)
                              if supervised_policy is not None else None)
         existing = ({symbol: None for symbol in self.symbols} if _prepare_only else
                     {symbol: self.store.forecast(cycle_id, symbol) for symbol in self.symbols})
         reused = {symbol: forecast for symbol, forecast in existing.items() if forecast is not None}
         selected = set(self.symbols if retry_symbols is None else retry_symbols)
         if not selected <= set(self.symbols):
             raise ContractError("Recovery changed the configured symbol scope")
         if not _prepare_only and saved.get("status") == "completed":
             if len(reused) != len(self.symbols):
                 raise ContractError("Completed cycle is missing immutable forecasts")
             self.store.event(cycle_id,"completed_cycle_reused",{"reused_symbols":list(reused),
                              "retrained_symbols":0,"original_measurements_preserved":True})
             for forecast in reused.values():
                 self._published(forecast, on_published)
             return {"cycle_id":cycle_id,**saved,"forecasts":reused,"recovered_existing":True}
         if hasattr(histories,"bind_cycle"):
             histories.bind_cycle(cycle_id)
         training_cutoff = instant(saved["training_cutoff"])
         start_perf = time.perf_counter()
         before = resource_snapshot()
         results = {symbol: forecast for symbol, forecast in reused.items() if symbol not in selected}
         prior_failures={**saved.get("failures", {}), **recorded_symbol_failures(self.store, cycle_id)}
         failures = {symbol: error for symbol, error in prior_failures.items()
                     if symbol not in selected and symbol not in reused}
         with ThreadPoolExecutor(max_workers=self.config.symbol_workers,thread_name_prefix="intraday-research") as pool:
             futures = {pool.submit(self._symbol, cycle_id, symbol, lambda s=symbol: histories.get(s), reference,
                         training_cutoff, mode, (intent_by_symbol or {}).get(symbol), on_published, start_perf,
                         allow_execution, supervised_policy, _prepare_only): symbol for symbol in self.symbols if symbol in selected}
             for future in as_completed(futures):
                 symbol = futures.pop(future)
                 try:
                     result = future.result()
                     if _prepare_only:
                         if _on_prepared is not None:
                             _on_prepared(cycle_id, symbol, saved, result)
                         results[symbol] = {"snapshot_hash": result[0]}
                     else:
                         results[symbol] = result
                 except Exception as exc:
                     from .data import AcquisitionPending
                     error = {"type":type(exc).__name__,"message":str(exc),"recorded_at":instant(self.clock()).isoformat(),
                              "diagnostics":_symbol_exception_diagnostics(exc)}
                     if isinstance(exc, AcquisitionPending):
                         error.update(retryable=True, reason=exc.reason,
                                      retry_after_seconds=exc.retry_after_seconds,
                                      retry_at=(instant(error["recorded_at"])+timedelta(seconds=exc.retry_after_seconds)).isoformat())
                     failures[symbol] = error
                     self.store.event(cycle_id,"symbol_failure",error,symbol=symbol)
                     # A crash between futures must not turn a known permanent
                     # model failure into an automatic data-prerequisite retry.
                     self.store.update_cycle(cycle_id,{"failures":dict(failures),
                         "pending_recovery_symbols":[s for s,e in failures.items() if e.get("retryable")]})
         elapsed = time.perf_counter()-start_perf
         after = resource_snapshot()
         end = instant(self.clock())
         if _prepare_only:
             summary = dict(status="prepared" if not failures and len(results) == len(self.symbols)
                            else "partial_preparation", prepared_at=end.isoformat(),
                            preparation_seconds=elapsed, prepared_symbols=list(results),
                            failed_symbols=len(failures), failures=failures,
                            pending_recovery_symbols=[s for s,e in failures.items() if e.get("retryable")])
             self.store.update_cycle(cycle_id, summary)
             self.store.event(cycle_id, "preparation_attempt_measured", {
                 "preparation_seconds": elapsed, "prepared_symbols": list(results),
                 "failed_symbols": list(failures), "training_calls": 0,
                 "resources_before": before, "resources_after": after})
             return {"cycle_id": cycle_id, **summary, "snapshots": results}
         acquisition_seconds=float((acquisition or {}).get("seconds",0.0))
