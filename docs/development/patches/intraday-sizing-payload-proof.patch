--- a/ml/intraday/technical_sizing.py
+++ b/ml/intraday/technical_sizing.py
@@ -238,0 +239,22 @@
+_PAYLOAD_PROOF_TOKEN = object()
+
+
+def _validated_payload(owner, identifier_name, error):
+    """Freshly decode immutable bytes; reuse only their successful validation."""
+    text = owner.payload_json
+    value = json.loads(text)
+    identifier = getattr(owner, identifier_name)
+    eligible = (type(owner) in (IndicatorSnapshot, SizingResult)
+                and type(text) is str and type(identifier) is str)
+    proof = owner.__dict__.get("_validated_payload_proof") if eligible else None
+    if not (type(proof) is tuple and len(proof) == 3
+            and proof[0] is _PAYLOAD_PROOF_TOKEN
+            and proof[1] is text and proof[2] is identifier):
+        if digest(value) != identifier:
+            raise ContractError(error)
+        if eligible:
+            object.__setattr__(owner, "_validated_payload_proof",
+                               (_PAYLOAD_PROOF_TOKEN, text, identifier))
+    return value
+
+
