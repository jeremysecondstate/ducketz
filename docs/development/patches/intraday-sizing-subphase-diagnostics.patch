+def _execution_loaded_generation(module_file):
+    """Identify this loaded source's sealed layout without IO or active pointers."""
+    try:
+        path = Path(module_file)
+        parts = path.parts
+        if (path.is_absolute() and len(parts) >= 6 and parts[-6] == "generations"
+                and parts[-4:] == ("source", "ml", "intraday", "account_execution.py")
+                and len(parts[-5]) == 64
+                and all(c in "0123456789abcdef" for c in parts[-5])):
+            return parts[-5]
+    except Exception:
+        pass
+    return None
+
+
+_LOADED_EXECUTION_GENERATION = _execution_loaded_generation(__file__)
+
+
+class _SizingTimings:
+    """Bounded inner-sizing clocks; telemetry never changes scientific evidence."""
+    _PHASES = frozenset({"intention_read", "frozen_inputs", "size_calculation", "sizing_persistence"})
+
+    def __init__(self):
+        self.phases = {}
+        self.elapsed_unavailable = self.thread_cpu_unavailable = False
+        self.loaded_generation = _LOADED_EXECUTION_GENERATION
+        self.candle_rows = None
+
+    def _clock(self, name):
+        try:
+            value = getattr(time, name)()
+            if type(value) in (int, float) and math.isfinite(value):
+                return value
+        except Exception:
+            pass
+        setattr(self, "thread_cpu_unavailable" if name == "thread_time" else "elapsed_unavailable", True)
+        return None
+
+    def _thread(self):
+        try:
+            return threading.get_ident()
+        except Exception:
+            self.thread_cpu_unavailable = True
+            return None
+
+    @contextmanager
+    def phase(self, name):
+        wall, cpu, thread = self._clock("monotonic"), self._clock("thread_time"), self._thread()
+        try:
+            yield
+        finally:
+            end, cpu_end, end_thread = self._clock("monotonic"), self._clock("thread_time"), self._thread()
+            try:
+                if name not in self._PHASES:
+                    self.elapsed_unavailable = True
+                    self.thread_cpu_unavailable = True
+                else:
+                    row = self.phases.setdefault(name, {})
+                    row["count"] = row.get("count", 0) + 1
+                    for start, stop, prefix in ((wall, end, ""), (cpu, cpu_end, "thread_cpu_")):
+                        if (start is None or stop is None or stop < start or not math.isfinite(stop - start)
+                                or (prefix and (thread is None or thread != end_thread))):
+                            setattr(self, "thread_cpu_unavailable" if prefix else "elapsed_unavailable", True)
+                            continue
+                        total = row.get(prefix + "total_seconds", 0.) + stop - start
+                        if not math.isfinite(total):
+                            setattr(self, "thread_cpu_unavailable" if prefix else "elapsed_unavailable", True)
+                            continue
+                        count_key = prefix + "count" if prefix else "elapsed_count"
+                        row[count_key] = row.get(count_key, 0) + 1
+                        row[prefix + "total_seconds"] = total
+                        row[prefix + "maximum_seconds"] = max(row.get(prefix + "maximum_seconds", 0.), stop - start)
+            except Exception:
+                self.elapsed_unavailable = self.thread_cpu_unavailable = True
+
+    def frozen(self, value):
+        try:
+            if type(value) is dict and type(value.get("candles")) in (list, tuple):
+                self.candle_rows = len(value["candles"])
+        except Exception:
+            self.elapsed_unavailable = True
+
+    def snapshot(self):
+        return dict(schema_version="intraday-sizing-subphase-diagnostics-v1",
+            phases={name: {key: round(value, 6) if type(value) is float else value
+                           for key, value in row.items()} for name, row in self.phases.items()},
+            candle_rows=self.candle_rows, loaded_generation=self.loaded_generation,
+            source_kind="sealed" if self.loaded_generation is not None else "unsealed",
+            elapsed_unavailable=self.elapsed_unavailable,
+            thread_cpu_unavailable=self.thread_cpu_unavailable, totals_are_inclusive=True)
 
 
