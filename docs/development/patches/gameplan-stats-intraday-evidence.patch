@@ -0,0 +1,315 @@
+"""Saved collector receipts feed Stats without acquiring data or changing targets."""
+import copy
+import json
+from pathlib import Path
+
+import pandas as pd
+import pytest
+
+from app.ui.gameplan_stats_data import load_gameplan_stats
+from ml.artifacts import file_checksum, verify_manifest, write_manifest
+from ml.gameplan_actuals_review import publish_completed_session_review
+from ml.gameplan_stats_handoff import OBSERVATION_ORIGIN_FIELDS, EXPORT_ROW_FIELDS, _validate_package, export_stats_package
+from ml.intraday.market_inputs import MarketInputStore
+from ml.stock_target_prices import OBSERVED_MULTI_STOCK_PRICE_SOURCE_V2, stock_price_dataset
+from tests.test_gameplan_actuals_review import publication_case
+from tests.test_gameplan_stats_direct_observations import direct
+
+
+DAY = "2026-09-09"
+EARLY = "2026-09-10T00:30Z"
+LATE = "2026-09-10T04:10Z"
+
+
+def candle(clock, *, price=100., close=101., **changes):
+    return {"date": DAY + " " + clock, "open": price, "high": max(price, close) + 1,
+            "low": min(price, close) - 1, "close": close, "volume": 20, **changes}
+
+
+def retain(root, payload, *, received="2026-09-09T12:01Z", status="ok"):
+    return MarketInputStore(root).append(symbol="AAPL", source="fmp_5min",
+        started_at=received, received_at=received, payload=payload,
+        features={}, status=status, producer_runtime={},
+        request={"endpoint": "historical-chart/5min", "params": {
+            "symbol": "AAPL", "from": DAY, "to": DAY,
+            "nonadjusted": "true", "extended": "true"}})
+
+
+@pytest.fixture
+def case(publication_case, monkeypatch):
+    """Freeze an original multi-source forecast before creating input receipts."""
+    c = publication_case
+    contract = OBSERVED_MULTI_STOCK_PRICE_SOURCE_V2
+    dataset = stock_price_dataset(contract)
+    config = c.original.manifest["configuration"]
+    config["target_price_source_contract"] = contract
+    (c.original.run_directory / "manifest.json").write_text(json.dumps(c.original.manifest))
+    for path in (c.original.run_directory / "forecasts.parquet", c.original_trade / "trade-plan.parquet"):
+        frame = pd.read_parquet(path)
+        frame["target_price_source_contract"] = contract
+        frame["target_price_dataset"] = dataset
+        frame.to_parquet(path, index=False)
+    planning_path = c.original_trade / "planning-price-path.json"
+    planning = json.loads(planning_path.read_text())
+    planning.update(price_source_contract=contract, price_dataset=dataset)
+    planning_path.write_text(json.dumps(planning))
+    manifest = json.loads((c.original_trade / "manifest.json").read_text())
+    write_manifest(c.original_trade, run_timestamp=pd.Timestamp(DAY, tz="UTC"), input_files=[],
+        output_files=["trade-plan.parquet", "planning-price-path.json"],
+        configuration=manifest["configuration"])
+    receipt_path = c.original_trade / "receipt.json"
+    receipt = json.loads(receipt_path.read_text())
+    receipt["manifest_sha256"] = file_checksum(c.original_trade / "manifest.json")
+    receipt_path.write_text(json.dumps(receipt))
+    monkeypatch.setattr("app.services.fmp_corporate_data.FmpCorporateDataProvider._get_json",
+        lambda *a, **kw: pytest.fail("Stats must only read saved observations"))
+    return c
+
+
+def publish(c, at=EARLY):
+    return publish_completed_session_review(c.root, action_date=DAY,
+        clock=lambda: pd.Timestamp(at), reconcile_existing=True)
+
+
+def first_row(run):
+    rows = pd.read_parquet(run / "forecast-results.parquet")
+    return rows.loc[rows.route.eq("1h@04:00")].iloc[0]
+
+
+def test_native_collector_prices_reach_stats_and_verified_ui(case):
+    original = pd.read_parquet(case.original.run_directory / "forecasts.parquet")
+    retained = retain(case.root, [candle("07:00:00"), candle("07:55:00", close=105.)])
+    before = {path: file_checksum(path) for path in case.root.rglob("*") if path.is_file()}
+    run = publish(case)
+    row = first_row(run)
+    assert row.actuals_status == "EVALUATED" and row.actual_return == pytest.approx(.05)
+    assert row.actual_start_observation_source == "fmp:historical-chart:5min"
+    assert row.actual_start_observation_producer == "intraday-market-input-collector-v2"
+    assert row.actual_start_observation_input_sha256 == retained["id"]
+    assert row.actual_end_observation_payload_sha256 == retained["payload_ref"]["sha256"]
+    assert row.actual_start_observation_recorded_at == retained["received_at"]
+    assert row.actual_start_observation_receipt_path == Path(retained["object_path"]).relative_to(case.root).as_posix()
+    saved = pd.read_parquet(run / "forecast-results.parquet")
+    pd.testing.assert_frame_equal(saved[original.columns], original, check_exact=True)
+    assert "direction_policy_version" not in original  # Historical absence stays unrecorded.
+    report = json.loads((run / "report.json").read_text())
+    assert report["forecasts"] == {"total": 24, "evaluated": 1, "pending_maturity": 6, "mature_awaiting_data": 17}
+    assert report["input_coverage_status"] == "MATURE_OBSERVATIONS_MISSING"
+    collector_inputs = [item for item in report["price_inventory"]["inventory"]
+                        if item.get("producer") == "intraday-market-input-collector-v2"]
+    assert collector_inputs and collector_inputs[0]["request"]["symbol"] == "AAPL"
+    assert collector_inputs[0]["payload_sha256"] == retained["payload_ref"]["sha256"]
+    assert all(file_checksum(path) == digest for path, digest in before.items())
+    assert not (case.root / "stocks/AAPL/bars/5m/fmp/raw-history").exists()
+    review = load_gameplan_stats(case.root, DAY)
+    outcome = next(value for value in review.outcomes if value.route == "1h@04:00")
+    assert outcome.start_origin.has_collector_receipt and outcome.end_origin.has_collector_receipt
+    assert "15-minute trader" in outcome.start_origin.label
+    assert review.metrics().pending == 6 and review.metrics().awaiting_data == 17
+    assert load_gameplan_stats(case.root).run_directory == run
+    verify_manifest(run)
+
