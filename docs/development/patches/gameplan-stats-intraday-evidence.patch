+            tuple(dict.fromkeys(paths)), inventory)
diff --git a/datafetching/intraday_fmp_observations.py b/datafetching/intraday_fmp_observations.py
new file mode 100644
--- /dev/null
+++ b/datafetching/intraday_fmp_observations.py
@@ -0,0 +1,121 @@
+"""Read saved 15-minute collector FMP responses without running the collector.
+
+The collector's raw five-minute provider payloads are separate from its derived
+15-minute candles, forecasts and execution state. Only these immutable native
+responses are exposed here; this module has no acquisition or writable store API.
+"""
+from contextlib import closing
+import hashlib
+import json
+from pathlib import Path
+import re
+import sqlite3
+
+import pandas as pd
+
+
+RECEIPT_VERSIONS = {"intraday-receipt-market-inputs-v1": "intraday-market-input-collector-v1",
+                    "intraday-receipt-market-inputs-v2": "intraday-market-input-collector-v2"}
+SOURCE = "fmp_5min"
+MAX_ENVELOPE_BYTES = 1024 * 1024
+MAX_PAYLOAD_BYTES = 4 * 1024 * 1024
+
+
+def _clock(value):
+    stamp = pd.Timestamp(value)
+    if pd.isna(stamp) or stamp.tzinfo is None:
+        raise ValueError("Saved intraday price receipt requires an aware clock")
+    return stamp.tz_convert("UTC")
+
+
+def _read_object(root, relative, digest, *, kind, maximum):
+    if not isinstance(relative, str) or not re.fullmatch(r"[a-f0-9]{64}", str(digest)):
+        raise ValueError("Invalid saved intraday price object identity")
+    path = (root / relative).resolve()
+    if not path.is_relative_to((root / kind).resolve()) or path.name != digest + ".json":
+        raise ValueError("Saved intraday price object escapes its immutable store")
+    if path.stat().st_size > maximum:
+        raise ValueError("Saved intraday price object exceeds its bounded contract")
+    raw = path.read_bytes()
+    if len(raw) > maximum or hashlib.sha256(raw).hexdigest() != digest:
+        raise RuntimeError("Saved intraday price object checksum mismatch")
+    return path, raw, json.loads(raw)
+
+
+def saved_market_responses(datastore_root, *, symbol, source,
+                           statuses=("ok", "empty", "extraction_unavailable")):
+    """Yield verified original responses and receipt clocks from a read-only index.
+
+    All retained dated revisions remain available to the consuming review's
+    evidence cutoff. A missing collector store is ordinary absent evidence.
+    Neither SQLite schema creation nor provider initialization occurs here.
+    """
+    datastore = Path(datastore_root).resolve()
+    root = datastore / "intraday/market-inputs"
+    database = root / "receipts.sqlite3"
+    if not database.is_file():
+        return
+    if not re.fullmatch(r"[A-Z][A-Z0-9.\-]{0,14}", symbol):
+        raise ValueError("Saved intraday price lookup requires an exact equity symbol")
+    with closing(sqlite3.connect(database.as_uri() + "?mode=ro", uri=True, timeout=5)) as db:
+        db.execute("PRAGMA query_only=ON")
+        cursor = db.execute("SELECT id,received_at,status,features,object_path FROM receipts "
+                            "WHERE symbol=? AND source=? ORDER BY received_at,id", (symbol, source))
+        while rows := cursor.fetchmany(256):
+            for identity, received, status, features, relative in rows:
+                envelope_path, _, envelope = _read_object(root, relative, identity,
+                    kind="objects", maximum=MAX_ENVELOPE_BYTES)
+                if (envelope.get("version") not in RECEIPT_VERSIONS or envelope.get("symbol") != symbol
+                        or envelope.get("source") != source or envelope.get("received_at") != received
+                        or envelope.get("status") != status or envelope.get("features") != json.loads(features)):
+                    raise ValueError("Saved intraday price catalog differs from its immutable receipt")
+                # Failed requests contain diagnostics rather than provider bars.
+                # Successful raw responses remain usable even if a downstream
+                # feature extractor failed, after full price validation below.
+                if status not in statuses:
+                    continue
+                request = envelope.get("request")
+                if isinstance(request, dict) and request.get("request_performed") is False:
+                    continue
+                if not isinstance(request, dict) or request.get("returned_identity_mismatch"):
+                    raise ValueError("Saved intraday price request identity differs")
+                received_at, started_at = _clock(received), _clock(envelope.get("request_started_at"))
+                if started_at > received_at:
+                    raise ValueError("Saved intraday price request follows its receipt")
+                reference = envelope.get("payload_ref")
+                if not isinstance(reference, dict):
+                    raise ValueError("Saved intraday price payload reference is missing")
+                payload_path, payload_bytes, payload = _read_object(root, reference.get("path"),
+                    reference.get("sha256"), kind="raw", maximum=MAX_PAYLOAD_BYTES)
+                if type(reference.get("bytes")) is not int or reference["bytes"] != len(payload_bytes):
+                    raise ValueError("Saved intraday price payload size differs")
+                paths = [envelope_path, payload_path]
+                runtime_ref = envelope.get("producer_runtime")
+                runtime_hash = None
+                if runtime_ref:
+                    if not isinstance(runtime_ref, dict):
+                        raise ValueError("Saved intraday producer reference is invalid")
+                    runtime_path, _, _ = _read_object(root, runtime_ref.get("path"),
+                        runtime_ref.get("sha256"), kind="producers", maximum=MAX_ENVELOPE_BYTES)
+                    runtime_hash = runtime_ref["sha256"]
+                    paths.append(runtime_path)
+                yield {"payload": payload, "request": request,
+                    "received_at": received_at, "request_started_at": started_at,
+                    "receipt_sha256": identity, "payload_sha256": reference["sha256"],
+                    "receipt_path": envelope_path.relative_to(datastore).as_posix(),
+                    "paths": tuple(paths), "producer": RECEIPT_VERSIONS[envelope["version"]],
+                    "producer_manifest_sha256": runtime_hash,
+                    "producer_runtime_metadata": "verified_manifest" if runtime_hash else "unrecorded",
+                    "collector_status": status}
+
+
+def saved_fmp_responses(datastore_root, *, symbol):
+    """Retain the original native chart request policy and collector identity."""
+    for saved in saved_market_responses(datastore_root, symbol=symbol, source=SOURCE):
+        request = saved["request"]
+        params = request.get("params")
+        if (request.get("endpoint") != "historical-chart/5min" or not isinstance(params, dict)
+                or params.get("symbol") != symbol or params.get("nonadjusted") != "true"
+                or params.get("extended") != "true"):
+            raise ValueError("Saved intraday price request lacks its native source policy")
+        yield saved | {"params": params}
