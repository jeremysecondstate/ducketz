+"""Native retained collector data remains read-only and explicitly opted in."""
+from contextlib import closing
+import hashlib
+import json
+from pathlib import Path
+import sqlite3
+import struct
+
+import pandas as pd
+import pytest
+
+from datafetching.fmp_price_history_receipts import load_native_five_minute_history
+from datafetching.intraday_dbn_observations import load_saved_equity_minutes
+from ml.intraday.market_inputs import MarketInputStore
+from ml.stock_observation_sources import completed_observation_bars
+from ml.stock_target_prices import load_stock_target_prices
+
+
+def retain(root, *, payload=None, **overrides):
+    row = {"date": "2026-10-26 07:00:00", "open": 10, "high": 12,
+           "low": 9, "close": 11, "volume": 3}
+    args = dict(symbol="AAPL", source="fmp_5min", started_at="2026-10-26T11:05:01Z",
+        received_at="2026-10-26T11:05:01Z", payload=[row] if payload is None else payload,
+        features={}, producer_runtime={}, request={"endpoint": "historical-chart/5min",
+            "params": {"symbol": "AAPL", "from": "2026-10-26", "to": "2026-10-26",
+                       "nonadjusted": "true", "extended": "true"}})
+    args.update(overrides)
+    return MarketInputStore(root).append(**args)
+
+
+def rewrite_envelope(root, saved, mutate):
+    store = Path(root) / "intraday/market-inputs"
+    old = Path(saved["object_path"])
+    value = json.loads(old.read_bytes())
+    mutate(value)
+    raw = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+    digest = hashlib.sha256(raw).hexdigest()
+    new = old.with_name(digest + ".json")
+    new.write_bytes(raw)
+    with closing(sqlite3.connect(store / "receipts.sqlite3")) as db:
+        db.execute("UPDATE receipts SET id=?,object_path=? WHERE id=?",
+                   (digest, str(new.relative_to(store)), saved["id"]))
+        db.commit()
+    return new
+
+
+def test_reader_absent_store_creates_nothing_and_default_does_not_opt_in(tmp_path):
+    assert load_native_five_minute_history(tmp_path, symbol="AAPL")[0].empty
+    assert not list(tmp_path.iterdir())
+    retain(tmp_path)
+    assert load_native_five_minute_history(tmp_path, symbol="AAPL")[0].empty
+    with pytest.raises(RuntimeError, match="No source-identified"):
+        load_stock_target_prices(tmp_path, symbols=["AAPL"],
+                                 source_contract="observed-multi-source-stock-v2")
+
+
+@pytest.mark.parametrize("version", ["v1", "v2"])
+def test_original_native_prices_provenance_and_cutoff(tmp_path, version):
+    saved = retain(tmp_path)
+    if version == "v1":
+        rewrite_envelope(tmp_path, saved, lambda row: row.update(version="intraday-receipt-market-inputs-v1"))
+    before = {p: p.read_bytes() for p in tmp_path.rglob("*") if p.is_file()}
+    frame, paths, inventory = load_native_five_minute_history(tmp_path, symbol="AAPL", include_saved_intraday=True)
+    assert frame.timestamp.tolist() == [pd.Timestamp("2026-10-26T11:00Z")]
+    assert frame.observation_interval_seconds.tolist() == [300]
+    assert frame.observation_producer.tolist() == ["intraday-market-input-collector-" + version]
+    assert frame.observation_source.tolist() == ["fmp:historical-chart:5min"]
+    assert frame.observation_payload_sha256.iloc[0] == saved["payload_ref"]["sha256"]
+    assert not Path(frame.observation_receipt_path.iloc[0]).is_absolute()
+    assert inventory[0]["producer_runtime_metadata"] == "unrecorded"
+    assert completed_observation_bars(frame, pd.Timestamp("2026-10-26T11:05Z")).empty
+    assert len(completed_observation_bars(frame, pd.Timestamp("2026-10-26T11:06Z"))) == 1
+    assert all(p.read_bytes() == raw for p, raw in before.items())
+    assert set(paths).issubset(before)
+
+
+@pytest.mark.parametrize("change", [
+    lambda row: row["request"]["params"].update(symbol="MSFT"),
+    lambda row: row["request"]["params"].update(nonadjusted="false"),
+    lambda row: row["payload_ref"].update(path="../outside.json"),
+    lambda row: row.update(source="fmp_quote"),
+    lambda row: row.update(received_at="2026-10-26T11:06:00Z"),
+])
+def test_catalog_cross_symbol_policy_and_path_mismatches_rejected(tmp_path, change):
+    saved = retain(tmp_path)
+    rewrite_envelope(tmp_path, saved, change)
+    with pytest.raises((ValueError, RuntimeError)):
+        load_native_five_minute_history(tmp_path, symbol="AAPL", include_saved_intraday=True)
+
+
+def test_raw_tamper_and_native_markers(tmp_path):
+    saved = retain(tmp_path)
+    raw = tmp_path / "intraday/market-inputs" / saved["payload_ref"]["path"]
+    raw.write_bytes(raw.read_bytes() + b" ")
+    with pytest.raises(RuntimeError, match="checksum"):
+        load_native_five_minute_history(tmp_path, symbol="AAPL", include_saved_intraday=True)
+
+
+@pytest.mark.parametrize("change", [{"synthetic": True}, {"no_trade": True}, {"volume": 0},
+                                    {"symbol": "MSFT"}, {"synthetic": "false"}])
+def test_invalid_native_rows_do_not_supply_prices(tmp_path, change):
+    row = {"date": "2026-10-26 07:00:00", "open": 10, "high": 12, "low": 9,
+           "close": 11, "volume": 3, **change}
+    retain(tmp_path, payload=[row])
+    frame, _, inventory = load_native_five_minute_history(tmp_path, symbol="AAPL", include_saved_intraday=True)
+    assert frame.empty and inventory[0]["invalid_or_zero_volume_rows_excluded"] == 1
+
+
+def native_dbn_fixture(root, *, mapped_symbol="AAPL", publisher=95, volume=3,
+                       definition_action="ADD", definition_class="STOCK", future_definition=False):
+    from databento_dbn import InstrumentDefMsg, OHLCVMsg, InstrumentClass, SecurityUpdateAction, RType
+    clock = pd.Timestamp("2026-10-26T11:00Z").value
+    definition = InstrumentDefMsg(publisher_id=95, instrument_id=123,
+        ts_event=clock + (86400000000000 if future_definition else 0),
+        ts_recv=clock, min_price_increment=10000000, display_factor=1000000000,
+        raw_symbol=mapped_symbol, asset=mapped_symbol, security_type="EQUITY",
+        instrument_class=getattr(InstrumentClass, definition_class),
+        security_update_action=getattr(SecurityUpdateAction, definition_action))
+    bar = OHLCVMsg(rtype=RType.OHLCV_1M, publisher_id=publisher, instrument_id=123, ts_event=clock,
+        open=10000000000, high=12000000000, low=9000000000, close=11000000000, volume=volume)
+    records = [(clock, definition), (clock + 61000000000, bar)]
+    raw = b"".join(struct.pack(">QI", stamp, len(bytes(record))) + bytes(record) for stamp, record in records)
+    path = root / "intraday/market-inputs/streams/EQUS.MINI/2026/10/26/test.frames"
+    path.parent.mkdir(parents=True)
+    path.write_bytes(raw)
+    segment = dict(path=str(path), sha256=hashlib.sha256(raw).hexdigest(), bytes=len(raw), records=2,
+                   encoding="receipt-ns-u64be,length-u32be,DBN-record")
+    saved = retain(root, source="db_equity", started_at="2026-10-26T11:00Z",
+        received_at="2026-10-26T11:02Z", payload={"raw_segments": [segment]},
+        request={"dataset": "EQUS.MINI", "schemas": ["definition", "ohlcv-1m"]})
+    return saved, path
+
+
+def test_native_dbn_segment_preserves_one_minute_contract_and_proof(tmp_path):
+    saved, path = native_dbn_fixture(tmp_path)
+    bars, files, inventory = load_saved_equity_minutes(tmp_path, symbol="AAPL")
+    assert len(bars) == 1 and bars.close.iloc[0] == 11
+    assert bars.observation_interval_seconds.iloc[0] == 60
+    assert bars.observation_source.iloc[0] == "databento:EQUS.MINI:ohlcv-1m"
+    assert bars.observation_input_sha256.iloc[0] == saved["id"]
+    assert bars.observation_payload_sha256.iloc[0] == saved["payload_ref"]["sha256"]
+    assert path in files and inventory[0]["rows"] == 1
+    with pytest.raises(RuntimeError, match="No source-identified"):
+        load_stock_target_prices(tmp_path, symbols=["AAPL"],
+                                 source_contract="observed-multi-source-stock-v2")
+    opted, _, _ = load_stock_target_prices(tmp_path, symbols=["AAPL"],
+        source_contract="observed-multi-source-stock-v1", include_saved_intraday=True)
+    assert opted.observation_source.tolist() == ["databento:EQUS.MINI:ohlcv-1m"]
+    canonical, _, _ = load_stock_target_prices(tmp_path, symbols=["AAPL"],
+        source_contract="canonical-equity-minute-v1", include_saved_intraday=True)
+    assert canonical.observation_input_sha256.tolist() == [saved["id"]]
+    assert completed_observation_bars(bars, pd.Timestamp("2026-10-26T11:01Z")).empty
+    path.write_bytes(path.read_bytes()[:-1] + b"x")
+    with pytest.raises(RuntimeError, match="checksum"):
+        load_saved_equity_minutes(tmp_path, symbol="AAPL")
+
+
+@pytest.mark.parametrize("options", [{"mapped_symbol": "MSFT"}, {"publisher": 2}, {"volume": 0},
+                                    {"definition_action": "DELETE"}, {"definition_class": "FUTURE"},
+                                    {"future_definition": True}])
+def test_dbn_other_symbol_publisher_and_empty_prices_remain_missing(tmp_path, options):
+    native_dbn_fixture(tmp_path, **options)
+    assert load_saved_equity_minutes(tmp_path, symbol="AAPL")[0].empty
+
+
+def test_unavailable_features_do_not_discard_verified_native_dbn_prices(tmp_path):
+    saved, _ = native_dbn_fixture(tmp_path)
+    store = tmp_path / "intraday/market-inputs"
+    rewrite_envelope(tmp_path, saved, lambda row: row.update(status="unavailable"))
+    with closing(sqlite3.connect(store / "receipts.sqlite3")) as db:
+        db.execute("UPDATE receipts SET status='unavailable'")
+        db.commit()
+    assert len(load_saved_equity_minutes(tmp_path, symbol="AAPL")[0]) == 1
+
+
+def test_unavailable_response_and_no_request_are_not_price_evidence(tmp_path):
+    retain(tmp_path, status="unavailable", payload={"error": "unavailable"},
+           request={"request_performed": False})
+    assert load_native_five_minute_history(tmp_path, symbol="AAPL", include_saved_intraday=True)[0].empty
+
+
+def test_future_saved_eq_us_conflict_does_not_invalidate_earlier_canonical_evidence(tmp_path):
+    native_dbn_fixture(tmp_path)
+    folder = tmp_path / "stocks/AAPL/bars/1m/databento/normalized"
+    folder.mkdir(parents=True)
+    pd.DataFrame({"timestamp": [pd.Timestamp("2026-10-26T11:00Z")],
+        "open": [10.], "close": [10.], "provider_dataset": ["EQUS.MINI"]}).to_parquet(
+            folder / "20261026_ohlcv-1m_1m.parquet", index=False)
+    bars, _, _ = load_stock_target_prices(tmp_path, symbols=["AAPL"], include_saved_intraday=True)
+    earlier = completed_observation_bars(bars, pd.Timestamp("2026-10-26T11:01Z"))
+    assert earlier.close.tolist() == [10.]
+    with pytest.raises(ValueError, match="conflicting source clocks"):
+        completed_observation_bars(bars, pd.Timestamp("2026-10-26T11:03Z"))
