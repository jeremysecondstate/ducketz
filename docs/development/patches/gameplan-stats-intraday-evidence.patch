+"""Saved snapshot timing, coverage and market-observation origin in the Stats UI."""
+import json
+from pathlib import Path
+
+import pandas as pd
+import pytest
+
+from app.ui.gameplan_stats_data import load_gameplan_stats
+from ml.artifacts import file_checksum, write_manifest
+from gameplan_stats_fixture import forecast, write_review
+from test_gameplan_stats_ui import tab, _finish_refresh
+
+
+def snapshot(root, *, session='2026-09-11', version='early', rows=None, mode='completed-session-before-training',
+             reviewed_at=None, parent=None):
+    run = write_review(root, rows, session=session, version=version)
+    report = json.loads((run/'report.json').read_text())
+    report.update(reviewed_at=reviewed_at or f'{session}T17:35:00-07:00', review_mode=mode,
+                  price_evidence_available_at=reviewed_at or f'{session}T17:35:00-07:00',
+                  input_coverage_status='MATURE_OBSERVATIONS_MISSING',
+                  target_price_source_contract='observed-multi-source-stock-v2')
+    if parent:
+        report['session_revision_parent'] = {'run_path': parent.relative_to(root).as_posix()}
+    (run/'report.json').write_text(json.dumps(report))
+    write_manifest(run,run_timestamp=report['reviewed_at'],input_files=[],
+        output_files=['forecast-results.parquet','report.json','Gameplan-results.md'],
+        configuration={'schema_version':report['schema_version'],'action_date':session})
+    receipt = json.loads((run/'receipt.json').read_text())
+    receipt['manifest_sha256'] = file_checksum(run/'manifest.json')
+    (run/'receipt.json').write_text(json.dumps(receipt))
+    for path in (root/'ml/gameplan-actuals-review-latest/run.json',root/f'ml/gameplan-actuals-review-by-date/{session}/run.json'):
+        value=json.loads(path.read_text())
+        value['current']['receipt_sha256']=file_checksum(run/'receipt.json')
+        path.write_text(json.dumps(value))
+    return run
+
+
+def origin_row(*, proof=True, recorded_at='2026-09-11T05:02:00-07:00'):
+    row=forecast()
+    for boundary in ('start','end'):
+        prefix=f'actual_{boundary}_observation_'
+        row[prefix+'source']='fmp:historical-chart:5min'
+        if proof:
+            row.update({prefix+'producer':'intraday-market-input-collector-v2',
+                prefix+'input_sha256':'a'*64,prefix+'payload_sha256':'b'*64,
+                prefix+'receipt_path':f"intraday/market-inputs/objects/2026/09/11/{'a'*64}.json",
+                prefix+'recorded_at':recorded_at})
+    return row
+
+
+@pytest.mark.parametrize('session,stamp,mode,label',[
+    ('2026-09-11','2026-09-11T17:35:00-07:00','completed-session-before-training','Early local snapshot'),
+    ('2026-11-02','2026-11-02T17:30:00-08:00','completed-session-before-training','Early local snapshot'),
+    ('2026-09-11','2026-09-11T21:00:00-07:00','completed-session-before-training','Local snapshot'),
+    ('2026-09-11','2026-09-12T00:15:00-07:00','completed-session-before-training','Local snapshot'),
+    ('2026-09-11','2026-09-11T17:35:00-07:00','combined-atlas-scout','Combined Atlas–Scout snapshot'),
+    ('2026-09-11','2026-09-11T17:35:00-07:00',None,'Saved snapshot'),
+])
+def test_reader_labels_actual_snapshot_without_relabelling_legacy_or_later_reviews(tmp_path,session,stamp,mode,label):
+    snapshot(tmp_path,session=session,rows=[forecast(session=session)],reviewed_at=stamp,mode=mode)
+    review=load_gameplan_stats(tmp_path,session)
+    assert review.snapshot_label==label
+    assert review.price_evidence_available_at.isoformat()==stamp
+    assert review.input_coverage_status=='MATURE_OBSERVATIONS_MISSING'
+    assert review.price_source_contract=='observed-multi-source-stock-v2'
+
+
+@pytest.mark.parametrize('producer',['intraday-market-input-collector-v1','intraday-market-input-collector-v2'])
+def test_reader_retains_exact_saved_collector_evidence_without_reading_raw_data(tmp_path,monkeypatch,producer):
+    import ml.stock_target_prices as prices
+    monkeypatch.setattr(prices,'load_stock_target_prices',lambda *a,**k:pytest.fail('UI cannot load market-price stores'))
+    row=origin_row(recorded_at=pd.Timestamp('2026-09-11T12:02Z'))
+    for boundary in ('start','end'):
+        row[f'actual_{boundary}_observation_producer']=producer
+    snapshot(tmp_path,rows=[row])
+    review=load_gameplan_stats(tmp_path)
+    row=review.outcomes[0]
+    assert row.start_origin.has_collector_receipt
+    assert row.start_origin.producer==producer
+    assert row.start_origin.input_sha256=='a'*64
+    assert row.start_origin.payload_sha256=='b'*64
+    assert row.start_origin.recorded_at.isoformat()=='2026-09-11T05:02:00-07:00'
+    assert review.observation_sources==("15-minute trader's saved market data (FMP 5-minute candles)",)
+    assert review.unrecorded_observations==0
+
+
+def test_provider_alone_never_claims_fifteen_minute_collector(tmp_path):
+    snapshot(tmp_path,rows=[origin_row(proof=False)])
+    review=load_gameplan_stats(tmp_path)
+    assert not review.outcomes[0].start_origin.has_collector_receipt
+    assert review.observation_sources==('FMP 5-minute candles · collector not recorded',)
+    assert '15-minute' not in review.observation_sources[0]
+
+
+@pytest.mark.parametrize('path',[
+    'saved-market-inputs/receipt.json',
+    f"C:/DATASTORE/intraday/market-inputs/objects/2026/09/11/{'a'*64}.json",
+    f"intraday/market-inputs/objects/2026/09/11/{'b'*64}.json",
+    f"intraday/market-inputs/objects/2026/09/11/../{'a'*64}.json",
+])
+def test_malformed_receipt_reference_never_claims_collector_origin(tmp_path,path):
+    row=origin_row()
+    for boundary in ('start','end'):
+        row[f'actual_{boundary}_observation_receipt_path']=path
+    snapshot(tmp_path,rows=[row])
+    review=load_gameplan_stats(tmp_path)
+    assert not review.outcomes[0].start_origin.has_collector_receipt
+    assert review.observation_sources==('FMP 5-minute candles · collector evidence incomplete',)
+
+
+def test_old_snapshot_origin_remains_unrecorded(tmp_path):
+    write_review(tmp_path,[forecast()])
+    review=load_gameplan_stats(tmp_path)
+    assert review.outcomes[0].start_origin is None
+    assert review.observation_sources==() and review.unrecorded_observations==2
+    assert review.snapshot_label=='Saved snapshot'
+
+
+def test_actual_tab_explains_early_time_partial_coverage_and_schedule(tab,tmp_path):
+    snapshot(tmp_path)
+    tab.set_review(load_gameplan_stats(tmp_path))
+    assert 'Early local snapshot' in tab.status.get()
+    assert 'Snapshot as of Sep 11, 17:35 PDT' in tab.status.get()
+    assert 'Outcomes through Sep 11, 17:00 PDT' in tab.status.get()
+    assert '5 evaluated · 1 awaiting market-price data · 1 awaiting maturity' in tab.status.get()
+    assert '17:30 Pacific' in tab.schedule_label.cget('text')
+    assert '17:00 session close' in tab.schedule_label.cget('text')
+    assert 'not recorded' in tab.sources_label.cget('text')
+
+
+def test_actual_dialog_displays_saved_origin_and_receipt_hashes(tab,tmp_path,monkeypatch):
+    snapshot(tmp_path,rows=[origin_row()])
+    tab.set_review(load_gameplan_stats(tmp_path))
+    shown=[]
+    monkeypatch.setattr(tab,'_text_dialog',lambda title,text:shown.append(text))
+    tab._show_outcome('AAPL',0,tab.review.outcomes[0])
+    assert "15-minute trader's saved market data" in shown[0]
+    assert 'Saved receipt time: Sep 11, 05:02:00 PDT' in shown[0]
+    assert 'a'*64 in shown[0] and 'b'*64 in shown[0]
+    assert "15-minute trader's saved market data" in tab.sources_label.cget('text')
+
+
+def test_tab_refreshes_same_session_revision_and_retains_original_artifact(tab,tmp_path):
+    parent=snapshot(tmp_path,version='first',rows=[forecast(status='MATURE_AWAITING_DATA')])
+    before={p.name:p.read_bytes() for p in parent.iterdir() if p.is_file()}
+    tab.set_review(load_gameplan_stats(tmp_path))
+    revised=snapshot(tmp_path,version='revised',rows=[origin_row()],reviewed_at='2026-09-11T21:45:00-07:00',parent=parent)
+    tab.refresh()
+    _finish_refresh(tab)
+    assert tab.review.run_directory==revised
+    assert tab.review.snapshot_label=='Local snapshot'
+    assert 'Revised saved evidence' in tab.status.get()
+    assert '1 evaluated · 0 awaiting market-price data · 0 awaiting maturity' in tab.status.get()
+    assert {p.name:p.read_bytes() for p in parent.iterdir() if p.is_file()}==before
