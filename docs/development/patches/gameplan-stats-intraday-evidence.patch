+"""Read native EQUS minute records retained by the independent intraday collector.
+
+Only framed provider OHLCV records are projected. Trades, quotes and derived
+15-minute features are never aggregated into target observations.
+"""
+import hashlib
+import json
+from pathlib import Path
+import re
+import struct
+
+import pandas as pd
+
+from datafetching.intraday_fmp_observations import saved_market_responses
+
+
+SOURCE = "databento:EQUS.MINI:ohlcv-1m"
+MAX_SEGMENT_BYTES = 64 * 1024 * 1024
+
+
+def _segment(root, reference):
+    from databento_dbn import DBNDecoder
+    if (not isinstance(reference, dict)
+            or reference.get("encoding") != "receipt-ns-u64be,length-u32be,DBN-record"
+            or type(reference.get("bytes")) is not int
+            or not 0 <= reference["bytes"] <= MAX_SEGMENT_BYTES
+            or not re.fullmatch(r"[a-f0-9]{64}", str(reference.get("sha256")))):
+        raise ValueError("Saved EQUS segment contract is invalid")
+    path = Path(reference.get("path", "")).resolve()
+    if not path.is_relative_to(root / "streams/EQUS.MINI") or path.suffix != ".frames":
+        raise ValueError("Saved EQUS segment escapes its original dataset")
+    if path.stat().st_size != reference["bytes"]:
+        raise ValueError("Saved EQUS segment size differs")
+    raw = path.read_bytes()
+    if len(raw) != reference["bytes"] or hashlib.sha256(raw).hexdigest() != reference["sha256"]:
+        raise RuntimeError("Saved EQUS segment checksum mismatch")
+    decoder, records, offset, count = DBNDecoder(has_metadata=False), [], 0, 0
+    while offset < len(raw):
+        if len(raw) - offset < 12:
+            raise ValueError("Saved EQUS frame is truncated")
+        received, length = struct.unpack_from(">QI", raw, offset)
+        offset += 12
+        if not 16 <= length <= 4096 or offset + length > len(raw):
+            raise ValueError("Saved EQUS frame length is invalid")
+        decoded = decoder.write_and_decode(raw[offset:offset + length])
+        offset += length
+        if len(decoded) != 1:
+            raise ValueError("Saved EQUS frame is not one complete native record")
+        record = decoded[0]
+        count += 1
+        # The dataset's original publisher identifies native EQUS.MINI records;
+        # neither an endpoint selection nor a projected symbol can replace it.
+        if int(record.publisher_id) == 95 and int(record.rtype) in (19, 33):
+            records.append((received, record))
+    if type(reference.get("records")) is not int or reference["records"] != count:
+        raise ValueError("Saved EQUS segment record count is invalid")
+    return path, records
+
+
+def load_saved_equity_minutes(datastore_root, *, symbol):
+    """Return verified native bars, immutable evidence paths and inventory."""
+    root = Path(datastore_root).resolve() / "intraday/market-inputs"
+    frames, paths, inventory, cache = [], [], [], {}
+    for saved in saved_market_responses(datastore_root, symbol=symbol, source="db_equity",
+                                       statuses=("ok", "empty", "extraction_unavailable", "unavailable")):
+        request, payload = saved["request"], saved["payload"]
+        if request.get("dataset") != "EQUS.MINI" or "ohlcv-1m" not in request.get("schemas", ()):
+            continue  # Another historical stream contract is not this source.
+        if not isinstance(payload, dict) or not isinstance(payload.get("raw_segments"), list):
+            if saved["collector_status"] == "unavailable":
+                continue  # An error response contains no native provider prices.
+            raise ValueError("Saved EQUS response has no native segment inventory")
+        records, segment_paths = [], []
+        for reference in payload["raw_segments"]:
+            key = json.dumps(reference, sort_keys=True)
+            if key not in cache:
+                cache[key] = _segment(root, reference)
+                if len(cache) > 128:
+                    cache.pop(next(iter(cache)))
+            path, selected = cache[key]
+            records.extend(selected)
+            segment_paths.append(path)
+        # Definitions come from verified native bytes, not projected features.
+        # An ambiguous instrument mapping is missing evidence, never guessed.
+        definitions, rows = {}, []
+        for received_ns, record in sorted(records, key=lambda item: item[0]):
+            received = pd.Timestamp(received_ns, unit="ns", tz="UTC")
+            if received > saved["received_at"]:
+                continue
+            instrument = int(record.instrument_id)
+            if int(record.rtype) == 19:
+                if (str(record.instrument_class) != "K"
+                        or str(record.security_update_action) not in {"A", "M"}
+                        or int(record.ts_event) > received_ns):
+                    definitions.pop(instrument, None)
+                    continue
+                definitions.setdefault(instrument, set()).add(str(record.raw_symbol).rstrip("\x00"))
+                continue
+            if definitions.get(instrument) != {symbol}:
+                continue
+            stamp = pd.Timestamp(record.ts_event, unit="ns", tz="UTC")
+            raw_prices = [getattr(record, field) for field in ("open", "high", "low", "close")]
