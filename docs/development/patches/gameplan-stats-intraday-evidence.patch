+def test_late_saved_receipt_revises_available_evidence_without_maturing_long_targets(case):
+    retain(case.root, [candle("07:00:00")])
+    early = publish(case)
+    assert first_row(early).actuals_status == "MATURE_AWAITING_DATA"
+    assert pd.isna(first_row(early).actual_end_observation_producer)
+    frozen = {path: file_checksum(path) for path in early.iterdir() if path.is_file()}
+    retain(case.root, [candle("07:00:00"), candle("07:55:00", close=105.)], received="2026-09-10T04:05Z")
+    assert publish(case, "2026-09-10T00:35Z") == early  # Future receipt stays unavailable.
+    later = publish(case, LATE)
+    assert later != early and first_row(later).actuals_status == "EVALUATED"
+    report = json.loads((later / "report.json").read_text())
+    assert report["session_revision_parent"]["receipt.json"] == frozen[early / "receipt.json"]
+    assert report["forecasts"]["pending_maturity"] == 6
+    assert report["outcomes_through"] == "2026-09-10T00:00:00+00:00"
+    assert all(file_checksum(path) == digest for path, digest in frozen.items())
+    assert publish(case, "2026-09-10T04:15Z") == later
+    assert load_gameplan_stats(case.root, DAY).run_directory == later
+
