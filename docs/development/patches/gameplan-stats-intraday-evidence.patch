+def test_default_v1_handoff_stays_compatible_and_optional_reader_proof_is_strict(case):
+    retained = retain(case.root, [candle("07:00:00"), candle("07:55:00", close=105.)])
+    run = publish(case)
+    destination = export_stats_package(case.root, producer="Atlas", symbols=["AAPL"],
+        destination=case.root / "package.json", action_date=DAY, review_run=run)
+    payload = json.loads(destination.read_text())
+    first = next(row for row in payload["rows"] if row["route"] == "1h@04:00")
+    assert set(first).issubset(EXPORT_ROW_FIELDS)
+    assert not set(OBSERVATION_ORIGIN_FIELDS) & set(first)
+    assert not set(OBSERVATION_ORIGIN_FIELDS) & set(_validate_package(payload).columns)
+    # New readers may retain optional evidence already supplied by a supported
+    # local materialization; the default v1 wire never requires peer upgrades.
+    local = first_row(run)
+    first.update({name: None if pd.isna(local[name]) else local[name]
+                  for name in OBSERVATION_ORIGIN_FIELDS})
+    assert first["actual_start_observation_input_sha256"] == retained["id"]
+    assert first["actual_start_observation_producer"] == "intraday-market-input-collector-v2"
+    assert str(case.root) not in destination.read_text()
+    validated = _validate_package(payload)
+    assert validated.loc[validated.route.eq("1h@04:00"), "actual_start_observation_input_sha256"].iloc[0] == retained["id"]
+    for field, value in (
+        ("receipt_path", "C:/DATASTORE/private/account.json"),
+        ("receipt_path", "intraday/market-inputs/objects/../../private.json"),
+        ("receipt_path", "intraday/market-inputs/objects/2026/09/09/" + "0" * 64 + ".json"),
+        ("payload_sha256", "credential-shaped-invalid-value"),
+        ("recorded_at", "2026-09-11T00:00:00Z"),
+        ("producer", "private-account-data"),
+        ("source", "https://example.invalid/?token=secret"),
+    ):
+        changed = copy.deepcopy(payload)
+        row = next(item for item in changed["rows"] if item["route"] == "1h@04:00")
+        row["actual_start_observation_" + field] = value
+        with pytest.raises(ValueError, match="Stats package"):
+            _validate_package(changed)
+    legacy = copy.deepcopy(payload)
+    for row in legacy["rows"]:
+        for field in list(row):
+            if field.startswith(("actual_start_observation_", "actual_end_observation_")):
+                del row[field]
+    assert len(_validate_package(legacy)) == len(payload["rows"])
+
