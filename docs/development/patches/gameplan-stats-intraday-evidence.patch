+    assert pd.isna(after.iloc[0].actual_start_observation_recorded_at)
+    pd.testing.assert_series_equal(after.iloc[1], before.iloc[1], check_exact=True)
+    scientific = [key for key in before if key not in (*revision._OUTCOMES, *OBSERVATION_ORIGIN_FIELDS)]
+    pd.testing.assert_frame_equal(after[scientific], before[scientific], check_exact=True)
+    assert all(file_checksum(path) == digest for path, digest in frozen.items())
