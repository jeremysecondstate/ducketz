# Start directional Loop B after Loop A has one COMPLETE generation. Pricing is
# deliberately not added to this default feature profile. After Pricing has a
# verified non-empty surface, its explicit shadow-only profile is
# loop-a-all-bsgp-shadow-v1.
python -m ml.prediction_runtime `
  --datastore-target pc `
  --symbols NVDA GOOG MU AAPL MSFT AMZN META TSLA CAT SNDK `
  --provider databento `
  --horizons 1h 4h 1d 1w `
  --feature-profile loop-a-all-v1 `
  --model-family logistic `
  --calibration platt `
  --round-trip-cost 0.001 `
  --interval-minutes 15 `
  --phase-offset-minutes 5

# Strategy is a separate consumer and cannot delay or mutate the Loop B run.
# This evidence-capture command intentionally enables Pricing diagnostics;
# they never change candidate ranking or order construction.
python -m ml.strategy_runtime `
  --datastore-target pc `
  --interval-minutes 15 `
  --phase-offset-minutes 10 `
  --pricing-mode shadow

# Both commands stop with Ctrl+C. Loop B publishes through ml/latest/run.json;
# Strategy publishes independently through ml/strategy-latest/run.json.
