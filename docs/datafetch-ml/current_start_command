# Start each command in its own PowerShell terminal. These processes share the
# datastore through immutable/atomic contracts; CME and Options do not run in
# Loop A's blocking path.

# 1. Independent complete-history CME/L2 owner.
python -m datafetching.cme_runtime `
  --datastore-target pc `
  --max-concurrency 1

# 2. Loop A. The external modes are explicit here even though they are defaults.
python -m datafetching.orchestrate `
  --datastore-target pc `
  --watchlist datafetching\watchlist.txt `
  --providers databento fmp fred schwab sec `
  --cme-mode external `
  --options-mode external `
  --interval-minutes 15

# 3. Pricing must run before Options captures the target quote,
# or the prediction cannot count as prospective evidence.
# Closed-market cycles can be monitor-only until a new completed quarter-hour
# bar appears; the runtime never backdates a prediction into an observed target.
python -m ml.option_pricing_runtime `
  --datastore-target pc `
  --watchlist datafetching\watchlist.txt `
  --interval-minutes 15 `
  --phase-offset-minutes 1 `
  --bar-readiness-mode required `
  --bar-readiness-timeout-seconds 45

# 4. Independent Schwab option-chain owner. It requires Loop A's immutable
# exact all-symbol Databento 1m readiness receipt.
python -m datafetching.options_runtime `
  --datastore-target pc `
  --watchlist datafetching\watchlist.txt `
  --interval-minutes 15 `
  --phase-offset-minutes 2 `
  --pricing-barrier-timeout-seconds 45 `
  --bar-readiness-mode required

# Stop any process with Ctrl+C. See independent-runtime-orchestration.md for
# ownership, restart, cadence, and compatibility details.

# POWERSHELL COMMANDS
cd C:\dev\ducketz
Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass
.\.venv\Scripts\Activate.ps1
