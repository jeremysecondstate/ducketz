  "policy": {
    "approval_contract": {
      "activation_requires_exact_policy_hash": true,
      "explicit_operator_approval_required": true,
      "new_eligibility_policy_and_receipts_required": true,
      "no_existing_evidence_may_be_reinterpreted": true
    },
    "bbo_alternative": {
      "fallback_to_future_quote_forbidden": true,
      "maximum_quote_age_seconds": 1,
      "method": "EXACT_HISTORICAL_CONSOLIDATED_BBO_MIDPOINT",
      "minimum_quality": "finite positive uncrossed bid and ask",
      "provider_interval_end_must_equal_target": true,
      "role": "SEPARATE_POLICY_ALTERNATIVE_AND_REQUIRED_SENSITIVITY_CHECK",
      "selection": "latest consolidated quote with event time at or before target",
      "separate_cost_authorization_required": true,
      "semantic_difference": "quote midpoint replaces last-trade price and may change moneyness membership"
    },
    "exact_rule": {
      "method": "EXACT_COMPLETED_DATABENTO_OHLCV_1M_CLOSE",
      "required_bar_end_equals_target": true,
      "status": "CURRENT_ACTIVE_RULE_REMAINS_UNCHANGED"
    },
    "failure_behavior": "NOT_PROVEN_WITHOUT_SCHEDULE_WIDENING_OR_CLUSTER_REMOVAL",
    "gap_rule": {
      "eligible_only_if": [
        "exact completed OHLCV-1m target is absent",
        "checksummed provider query proves no trade in the target minute",
        "source and target are in the same exchange session",
        "source bar end is strictly before target",
        "target minus source bar end is at most 60 seconds",
        "source close is finite and positive under the same adjustment policy",
        "no halt, session boundary, or corporate-action boundary intervenes"
      ],
      "future_bar_may_confirm_missingness_but_may_not_select_or_price": true,
      "maximum_staleness_seconds": 60,
      "method": "STRICTLY_PRIOR_LAST_TRADE_CARRY_FORWARD",
      "next_interval_fallback_forbidden": true,
      "persisted_proof_fields": [
        "target_snapshot_for",
        "source_bar_end_timestamp",
        "source_trade_timestamp",
        "staleness_seconds",
        "selection_method",
        "no_trade_query_receipt_checksum",
        "source_file_checksum",
        "policy_hash"
      ],
      "selection": "latest causally known prior trade close satisfying every predicate"
    },
    "policy_id": "opra-underlying-no-trade-asof-v2",
    "scope": {
      "mode": "OFFLINE_OPRA_ELIGIBILITY_ONLY",
      "required_clusters_per_symbol": 504,
      "symbols": [
        "NVDA",
        "GOOG",
        "MU"
      ]
    },
